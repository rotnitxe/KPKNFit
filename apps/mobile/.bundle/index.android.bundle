    // Sort by date descending
    var sorted = [...bodyProgress].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
    var latest = sorted[0];
    var previous = sorted[1];
    if (typeof latest.weight !== 'number' || typeof previous.weight !== 'number') return null;
    var delta = Math.round((latest.weight - previous.weight) * 10) / 10;
    var diffTime = Math.abs(new Date(latest.date).getTime() - new Date(previous.date).getTime());
    var days = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
    return {
      delta,
      days
    };
  }
