  function normalizeWikiText(value) {
    return value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  }
  function searchWiki(items, query) {
    if (!query) return items;
    var normalizedQuery = normalizeWikiText(query);
    return items.filter(item => {
      var name = normalizeWikiText(item.name);
      var desc = normalizeWikiText(item.description);
      return name.includes(normalizedQuery) || desc.includes(normalizedQuery);
    });
  }
