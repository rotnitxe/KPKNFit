rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function account(uid) {
      return firestore.get(/databases/(default)/documents/accounts/$(uid)).data;
    }
    function owned(uid) { return request.auth != null && request.auth.uid == uid && account(uid).state == 'ACTIVE'; }
    function pro(uid) {
      let entitlement = firestore.get(/databases/(default)/documents/entitlements/$(uid)).data;
      return firestore.exists(/databases/(default)/documents/entitlements/$(uid)) &&
        entitlement.level == 'PRO' && entitlement.state in ['ACTIVE', 'GRACE', 'CANCELED'] && request.time < entitlement.validUntil;
    }
    match /accounts/{uid}/{generation}/media/{fileId} {
      allow read: if owned(uid) && generation == account(uid).generationText;
      allow delete: if owned(uid) && generation == account(uid).generationText;
      allow create: if resource == null && owned(uid) && generation == account(uid).generationText && pro(uid) &&
        request.resource.size <= 256 * 1024 * 1024 &&
        (request.resource.contentType.matches('(image|video)/.*') ||
          request.resource.contentType == 'application/json' && request.resource.metadata.role == 'pose') &&
        request.resource.metadata.ownerUid == uid && request.resource.metadata.fileId == fileId;
      allow update: if false;
    }
    // Structured personal data is Free, including programs larger than Firestore's document limit.
    match /accounts/{uid}/{generation}/data/{hash} {
      allow read: if owned(uid) && generation == account(uid).generationText;
      allow create: if resource == null && owned(uid) && generation == account(uid).generationText &&
        hash.matches('[a-f0-9]{64}') && request.resource.size <= 64 * 1024 * 1024 &&
        request.resource.contentType == 'application/json' && request.resource.metadata.ownerUid == uid &&
        request.resource.metadata.fileId == hash;
      // Replacement and removal go through the server; accepted references stay immutable.
      allow update, delete: if false;
    }
    match /{path=**} { allow read, write: if false; }
  }
}
