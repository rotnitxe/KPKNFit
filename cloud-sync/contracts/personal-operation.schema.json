{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kpkn.app/contracts/personal-operation-v1",
  "title": "KPKN personal operation v1",
  "type": "object",
  "required": ["schemaVersion", "operationId", "entityId", "deviceId", "accountGeneration", "baseRevision", "kind", "changedAtEpochMs", "zoneId", "unitSystem", "deleted", "payload"],
  "properties": {
    "schemaVersion": {"const": 1},
    "operationId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "entityId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "sourceId": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096, "description": "When present, entityId equals this ASCII identifier or r_ followed by its SHA256 UTF-8 digest. Server limits also bound UTF-16 code units."},
    "deviceId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "accountGeneration": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "baseRevision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "kind": {"type": "string", "enum": ["program", "workout_log", "ongoing_workout", "active_program", "settings", "competition", "body_observation", "body_goal", "nutrition_log", "nutrition_plan", "nutrition_active_state", "pantry_item", "meal_template", "custom_food", "learned_resolution", "nutrition_calibration", "daily_goal_snapshot", "wellbeing", "sleep", "sleep_extended", "post_session_feedback", "session_template", "custom_exercise", "workout_tag", "context_performance", "global_performance", "context_profile", "replacement_decision", "performance_range", "performance_snapshot", "workout_media", "workout_media_association", "setup_draft", "setup_commit_receipt", "adaptive_state"]},
    "changedAtEpochMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "zoneId": {"type": "string", "minLength": 1, "maxLength": 80},
    "unitSystem": {"enum": ["METRIC", "IMPERIAL"]},
    "deleted": {"type": "boolean"},
    "payload": {"type": ["object", "null"]},
    "payloadRef": {"type": ["object", "null"], "properties": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 67108864}}, "required": ["sha256", "bytes"]},
    "guestImportId": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"}
  },
  "allOf": [
    {"if": {"properties": {"deleted": {"const": false}}}, "then": {"anyOf": [{"properties": {"payload": {"type": "object"}}}, {"properties": {"payloadRef": {"type": "object"}}, "required": ["payloadRef"]}]}},
    {"if": {"properties": {"deleted": {"const": true}}}, "then": {"properties": {"payload": {"type": "null"}, "payloadRef": {"type": "null"}}}},
    {"if": {"properties": {"deleted": {"const": false}, "payloadRef": {"type": "object"}}, "required": ["payloadRef"]}, "then": {"properties": {"payload": {"type": "null"}}}}
  ],
  "additionalProperties": true
}
