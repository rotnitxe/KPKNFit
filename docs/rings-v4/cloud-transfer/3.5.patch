index 0000000000000000000000000000000000000000..6959b302a871c4384453bba9376940426debe754
--- /dev/null
+++ b/android-native/app/src/main/java/com/example/kpkn/domain/auge/AugeModelSkill.kt
@@ -0,0 +1,99 @@
+package com.example.kpkn.domain.auge
+
+import com.example.kpkn.data.models.*
+import kotlin.math.abs
+import kotlin.math.exp
+import kotlin.math.sqrt
+
+/** Habilidad pareada antes de aprender; no mezcla escalas ni consulta el reloj. */
+object AugeModelSkill {
+    fun finish(
+        before: AugeAdaptiveCache,
+        observation: AugeLearningObservation,
+        model: AugeObservationModel,
+        result: AugeLearnerResult,
+    ): AugeLearnerResult {
+        if (result.outcome.status == AugeObservationStatus.REJECTED) return result
+        val key = AugeAdaptiveCacheMigration.parameterKey(observation.parameterKey)
+        val prior = AugeAdaptiveCacheMigration.prior(key)
+        val previous = before.parameterStates[key]?.takeIf { it.paramsVersion == AugeParameters.VERSION } ?: prior
+        val id = AugeAdaptiveCacheMigration.observationId(key, observation.anchorMs, observation.y, observation.relevantLogId)
+        val record = result.cache.observations.firstOrNull { it.id == id } ?: return result
+        val eligible = result.outcome.status == AugeObservationStatus.ADMITTED || result.outcome.reason == "zona_muerta"
+        var state = result.cache.parameterStates[key] ?: previous
+        var updatedRecord = record.copy(scale = observation.scale)
+        var rollback = false
+        if (eligible) {
+            val basePrediction = model.predictPrior(key)
+            if (basePrediction.battery.isFinite() && !basePrediction.atFloor && !basePrediction.blocked &&
+                basePrediction.battery < AugeParameters.LEARNER_SATURATION_THRESHOLD
+            ) {
+                val old = previous.skillByScale[observation.scale] ?: AugeSkillMetrics()
+                val nu = observation.y - record.predicted
+                val priorNu = observation.y - basePrediction.battery
+                val metrics = accumulate(old, nu, priorNu, observation.source, observation.observedAtMs)
+                state = state.copy(skillByScale = previous.skillByScale + (observation.scale to metrics))
+                rollback = !previous.frozen && metrics.pairedCount >= AugeParameters.SKILL_MIN_PAIRS &&
+                    metrics.adaptedError > AugeParameters.SKILL_ROLLBACK_RATIO * metrics.priorError
+                updatedRecord = updatedRecord.copy(priorPredicted = basePrediction.battery)
+            }
+        }
+        val frozen = previous.frozen || rollback
+        var outcome = result.outcome
+        if (frozen) {
+            state = state.copy(
+                mean = prior.mean,
+                variance = prior.variance,
+                n = previous.n,
+                lastUpdatedAtMs = previous.lastUpdatedAtMs,
+                frozen = true,
+                frozenAtMs = previous.frozenAtMs ?: observation.observedAtMs,
+                frozenReason = previous.frozenReason ?: "error_superior_al_prior",
+            )
+            if (rollback || outcome.status == AugeObservationStatus.ADMITTED) {
+                outcome = AugeObservationOutcome(AugeObservationStatus.CENSORED, if (rollback) "rollback_al_prior" else "parametro_congelado")
+                updatedRecord = updatedRecord.copy(outcome = outcome)
+            }
+        }
+        var next = result.cache.copy(
+            parameterStates = result.cache.parameterStates + (key to state),
+            observations = result.cache.observations.map { if (it.id == id) updatedRecord else it },
+        )
+        if (frozen) next = when (key) {
+            "cns" -> next.copy(cnsRecoveryHours = exp(prior.mean))
+            "spinal" -> next.copy(spinalRecoveryHours = exp(prior.mean))
+            else -> next.copy(personalizedRecoveryHours = next.personalizedRecoveryHours + (key to exp(prior.mean)))
+        }
+        val detail = if (frozen) result.detail?.copy(meanAfter = prior.mean, varianceAfter = prior.variance) else result.detail
+        return result.copy(cache = next, outcome = outcome, detail = detail)
+    }
+
+    fun accumulate(old: AugeSkillMetrics, nu: Double, priorNu: Double, source: String, atMs: Long): AugeSkillMetrics {
+        require(nu.isFinite() && priorNu.isFinite())
+        fun step(values: AugeSkillValues): AugeSkillValues {
+            fun ewma(previous: Double, value: Double) = if (values.pairedCount == 0) value else
+                (1.0 - AugeParameters.SKILL_EWMA_BETA) * previous + AugeParameters.SKILL_EWMA_BETA * value
+            return AugeSkillValues(values.pairedCount + 1, ewma(values.adaptedError, abs(nu)),
+                ewma(values.priorError, abs(priorNu)), ewma(values.bias, nu), atMs)
+        }
+        val total = step(old.values)
+        return AugeSkillMetrics(total, old.bySource + (source to step(old.bySource[source] ?: AugeSkillValues())))
+    }
+
+    /** Transiciones durables: el llamador emite estos datos solo después del commit de caché. */
+    fun rollbacks(before: AugeAdaptiveCache, after: AugeAdaptiveCache): List<AugeRollbackEvent> =
+        after.parameterStates.mapNotNull { (key, state) ->
+            if (state.frozen && before.parameterStates[key]?.takeIf { it.paramsVersion == state.paramsVersion }?.frozen != true)
+                AugeRollbackEvent(key, state.frozenAtMs ?: state.lastUpdatedAtMs, state.paramsVersion)
+            else null
+        }
+
+    fun presentation(cache: AugeAdaptiveCache): Map<RecoveryChannelId, List<AugeModelAccuracy>> =
+        cache.parameterStates.filterValues { it.paramsVersion == AugeParameters.VERSION }.flatMap { (key, state) ->
+            state.skillByScale.map { (scale, metric) ->
+                val channel = when (key) { "cns" -> RecoveryChannelId.SYSTEM; "spinal" -> RecoveryChannelId.STRUCTURE; else -> RecoveryChannelId.MUSCULAR }
+                channel to AugeModelAccuracy(key, scale, metric, exp(state.mean),
+                    exp(state.mean - 1.96 * sqrt(state.variance)), exp(state.mean + 1.96 * sqrt(state.variance)), state.n, state.frozen)
+            }
+        }.groupBy({ it.first }, { it.second })
+}
