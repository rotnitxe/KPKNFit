+package com.example.kpkn.screens.home
+
+import android.app.Application
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.ui.semantics.SemanticsActions
+import androidx.compose.ui.test.*
+import androidx.compose.ui.test.junit4.createComposeRule
+import com.example.kpkn.data.models.*
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34], application = Application::class)
+class AugeModelAccuracyCardTest {
+    @get:Rule val rule = createComposeRule()
+
+    @Test fun noDataDoesNotClaimPrecisionOrExposeParameterControls() {
+        rule.setContent { AugeModelAccuracyCard(emptyList()) }
+        rule.onNodeWithText("Sin datos suficientes").assertExists()
+        rule.onNodeWithText("Estimación base").assertExists()
+        rule.onAllNodes(SemanticsMatcher.keyIsDefined(SemanticsActions.SetText)).assertCountEquals(0)
+        rule.onAllNodes(SemanticsMatcher.keyIsDefined(SemanticsActions.SetProgress)).assertCountEquals(0)
+        rule.onAllNodes(SemanticsMatcher.keyIsDefined(SemanticsActions.OnClick)).assertCountEquals(0)
+    }
+
+    @Test fun measuredAndFrozenStatesRemainReadOnlyAfterRecomposition() {
+        val entry = AugeModelAccuracy("cns", "shown", AugeSkillMetrics(
+            AugeSkillValues(8, 12.0, 10.0, -3.0, 1760000000000L),
+            mapOf("manual" to AugeSkillValues(8, 12.0, 10.0, -3.0, 1760000000000L))),
+            36.0, 24.0, 48.0, 7, false)
+        val entries = mutableStateOf(listOf(entry))
+        rule.setContent { AugeModelAccuracyCard(entries.value) }
+        rule.onNodeWithText("τ estimado:", substring = true).assertExists()
+        rule.onNodeWithText("Error medio reciente:", substring = true).assertExists()
+        rule.runOnIdle { entries.value = listOf(entry.copy(frozen = true)) }
+        rule.onNodeWithText("Estamos usando la estimación base porque se ajusta mejor a tus últimas referencias").assertExists()
+        rule.onAllNodes(SemanticsMatcher.keyIsDefined(SemanticsActions.OnClick)).assertCountEquals(0)
+    }
+}
