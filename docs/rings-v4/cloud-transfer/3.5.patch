+package com.example.kpkn.screens.home
+
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.testTag
+import androidx.compose.ui.unit.dp
+import com.example.kpkn.data.models.AugeModelAccuracy
+import com.example.kpkn.screens.onboarding.design.WizardColors
+import com.example.kpkn.ui.design.KpknType
+import java.util.Locale
+import kotlin.math.abs
+
+/** Lectura del mismo snapshot que los anillos; abrir o recomponer no realiza ninguna escritura. */
+@Composable
+internal fun AugeModelAccuracyCard(entries: List<AugeModelAccuracy>, modifier: Modifier = Modifier) {
+    fun points(value: Double) = String.format(Locale.getDefault(), "%.1f", value)
+    Column(modifier.fillMaxWidth().testTag("auge-model-accuracy"), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+        Text("Precisión del modelo", style = KpknType.bodyStrong, color = WizardColors.text)
+        Text("Tu recuperación", style = KpknType.caption, color = WizardColors.textMuted)
+        if (entries.isEmpty()) {
+            Text("Sin datos suficientes", style = KpknType.body, color = WizardColors.text)
+            Text("Aún estamos reuniendo referencias sobre tu recuperación", style = KpknType.caption, color = WizardColors.textMuted)
+            Text("Estimación base", style = KpknType.caption, color = WizardColors.textMuted)
+        }
+        entries.sortedWith(compareBy({ it.parameterKey }, { it.scale })).forEach { entry ->
+            val values = entry.metrics.values
+            val label = when (entry.parameterKey) { "cns" -> "Energía"; "spinal" -> "Columna"; else -> entry.parameterKey.replaceFirstChar { it.uppercase() } }
+            val scale = if (entry.scale == "shown") "escala mostrada" else "escala del modelo"
+            Text("$label · $scale · ${values.pairedCount} referencias válidas", style = KpknType.caption, color = WizardColors.text)
+            if (values.pairedCount < 8) Text("Aún estamos reuniendo referencias sobre tu recuperación", style = KpknType.caption, color = WizardColors.textMuted)
+            else {
+                Text("Error medio reciente: ${points(values.adaptedError)} puntos de batería", style = KpknType.body, color = WizardColors.text)
+                val direction = if (values.bias >= 0.0) "por encima" else "por debajo"
+                Text("Tus referencias suelen estar ${points(abs(values.bias))} puntos $direction de la estimación", style = KpknType.caption, color = WizardColors.textMuted)
+            }
+            val sources = entry.metrics.bySource.entries.sortedBy { it.key }.joinToString(" · ") { (source, metric) ->
+                "${when (source) { "manual" -> "Sensación manual"; "e1rm" -> "Rendimiento e1RM"; "delta_rpe" -> "Esfuerzo RPE"; else -> source }}: ${metric.pairedCount}"
+            }
+            Text(sources, style = KpknType.caption, color = WizardColors.textMuted)
+            val date = java.time.Instant.ofEpochMilli(values.lastObservedAtMs).atZone(java.time.ZoneId.systemDefault()).toLocalDate()
+            Text("Última referencia: $date · ${entry.updateCount} actualizaciones del modelo", style = KpknType.caption, color = WizardColors.textMuted)
+            if (entry.frozen) Text("Estamos usando la estimación base porque se ajusta mejor a tus últimas referencias", style = KpknType.caption, color = WizardColors.textMuted)
+            else if (entry.updateCount == 0) Text("Estimación base", style = KpknType.caption, color = WizardColors.textMuted)
+            else Text("τ estimado: ${points(entry.tauHours)} h · intervalo del modelo: ${points(entry.lowerTauHours)}–${points(entry.upperTauHours)} h", style = KpknType.caption, color = WizardColors.textMuted)
+        }
+    }
+}
