+package com.example.kpkn.domain.auge
+
+import com.example.kpkn.data.models.*
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import org.junit.Assert.*
+import org.junit.Test
+import java.time.ZoneId
+import kotlin.math.exp
+import kotlin.math.ln
+
+class AugeLearnerRollbackTest {
+    private val base = AugeSyntheticUserHarness.BASE_START_MS
+    private val key = "cns"
+    private val prior = AugeAdaptiveCacheMigration.prior(key)
+    private val toy = AugeObservationModel { _, theta -> AugePrediction(100.0 - 10.0 * theta) }
+
+    private fun observation(index: Int, y: Double, source: String = "manual", parameter: String = key) =
+        AugeLearningObservation(parameter, y, 5.0, source, base + index * 1000L, base + index * 1000L, "log", 24.0)
+
+    private fun wrongCache() = AugeAdaptiveCache(cnsRecoveryHours = 120.0,
+        parameterStates = mapOf(key to prior.copy(mean = ln(120.0), variance = 0.0)))
+
+    @Test fun ewma_initializesFromTheFirstPair_andSeparatesSourcesAndScales() {
+        val first = AugeModelSkill.accumulate(AugeSkillMetrics(), 10.0, 8.0, "manual", base)
+        val second = AugeModelSkill.accumulate(first, -5.0, -4.0, "e1rm", base + 1)
+        assertEquals(9.0, second.values.adaptedError, 1e-12)
+        assertEquals(7.0, second.values.bias, 1e-12)
+        assertEquals(7.2, second.values.priorError, 1e-12)
+        assertEquals(10.0, second.bySource.getValue("manual").adaptedError, 1e-12)
+        assertEquals(5.0, second.bySource.getValue("e1rm").adaptedError, 1e-12)
+        assertEquals(2, second.pairedCount)
+        assertTrue(AugeModelSkill.presentation(AugeAdaptiveCache()).isEmpty())
+    }
+
+    @Test fun rollback_isOnTheEighthPair_forManualAndPerformance_andPersistsAcrossRingOverflow() {
+        for (source in listOf("manual", "e1rm", "delta_rpe")) {
+            var cache = wrongCache()
+            val y = toy.predictPrior(key).battery + 1.0
+            var transitions = 0
+            for (index in 1..220) {
+                val before = cache
+                cache = AugeLearner.update(cache, observation(index, y, source), toy).cache
+                transitions += AugeModelSkill.rollbacks(before, cache).size
+                if (index < 8) assertFalse(cache.parameterStates.getValue(key).frozen)
+                if (index == 8) {
+                    assertTrue(cache.parameterStates.getValue(key).frozen)
+                    val state = cache.parameterStates.getValue(key)
+                    assertEquals(prior.mean, state.mean, 1e-12)
+                    assertEquals(prior.variance, state.variance, 1e-12)
+                    cache = Json.decodeFromString<AugeAdaptiveCache>(Json.encodeToString(cache))
+                }
+                if (index >= 8) assertEquals(exp(prior.mean), cache.cnsRecoveryHours!!, 1e-12)
+            }
+            assertEquals(1, transitions)
+            val frozenState = cache.parameterStates.getValue(key)
+            val replay = AugeLearner.update(cache, observation(1, y, source), toy)
+            assertEquals(cache, replay.cache)
+            assertEquals(220, frozenState.skillByScale.getValue("historical_raw").pairedCount)
+            assertTrue(AugeModelSkill.rollbacks(cache, replay.cache).isEmpty())
+            val other = AugeLearner.update(cache, observation(221, 50.0, parameter = "spinal"), toy)
+            assertEquals(AugeObservationStatus.ADMITTED, other.outcome.status)
+            assertFalse(other.cache.parameterStates.getValue("spinal").frozen)
+        }
+    }
+
+    @Test fun exactFifteenPercentBoundary_andZeroPriorError_areNotHiddenByEpsilon() {
+        fun evaluate(adapted: Double, priorError: Double): AugeParameterState {
+            // Con varianza cero h es constante; se prueba la frontera sin que el entrenamiento mueva h.
+            val y = 60.0
+            val model = object : AugeObservationModel {
+                override fun predict(parameterKey: String, lnTau: Double) = AugePrediction(y - adapted - (lnTau - prior.mean))
+                override fun predictPrior(parameterKey: String) = AugePrediction(y - priorError)
+            }
+            var cache = AugeAdaptiveCache(parameterStates = mapOf(key to prior.copy(variance = 0.0)))
+            repeat(8) { index -> cache = AugeLearner.update(cache, observation(index + 1, y), model).cache }
+            return cache.parameterStates.getValue(key)
+        }
+        assertFalse(evaluate(11.5, 10.0).frozen)
+        assertTrue(evaluate(11.5001, 10.0).frozen)
+        assertFalse(evaluate(0.0, 0.0).frozen)
+        assertTrue(evaluate(1.0, 0.0).frozen)
+    }
+
+    @Test fun censoredAndDuplicateObservations_doNotChangeSkill_andVersionsDoNotMix() {
+        var cache = wrongCache()
+        val first = observation(1, 75.0)
+        cache = AugeLearner.update(cache, first, toy).cache
+        val metric = cache.parameterStates.getValue(key).skillByScale
+        assertEquals(cache, AugeLearner.update(cache, first, toy).cache)
+        for ((index, obs) in listOf(
+            observation(2, 100.0), observation(3, 75.0).copy(hoursSinceRelevantLoad = 7.99),
+        ).withIndex()) {
+            cache = AugeLearner.update(cache, obs, toy).cache
+            assertEquals("censura $index", metric, cache.parameterStates.getValue(key).skillByScale)
+        }
+        val incompatible = cache.copy(parameterStates = mapOf(key to cache.parameterStates.getValue(key).copy(paramsVersion = AugeParameters.VERSION + 1)))
+        val reset = AugeLearner.update(incompatible, observation(4, toy.predictPrior(key).battery + 1.0), toy).cache
+        assertEquals(1, reset.parameterStates.getValue(key).skillByScale.getValue("historical_raw").pairedCount)
+    }
+
+    @Test fun realEngine_adversarialOverconfidentPosterior_rollsBackBeforeTheNewAnchor() {
+        val at = base + 24L * AugeSyntheticUserHarness.HOUR_MS
+        val exercises = listOf(AugeSyntheticUserHarness.completedExercise("sim-banca", 16, 8, 70.0, 9.0, 120, "adverso"))
+        val log = AugeSyntheticUserHarness.logFor("adverso", "Sesión", exercises, base, 60, emptyList(), Settings())
+        var cache = wrongCache()
+        var transitions = 0
+        repeat(18) { index ->
+            val inputs = AugeSnapshotInputs(listOf(log), null, Settings(), AugeSyntheticUserHarness.exerciseDb,
+                at + index * 1000L, ZoneId.of("UTC"), adaptiveCache = cache)
+            val model = SnapshotObservationModel(inputs, inputs.nowMs, ObservationScale.HISTORICAL_RAW)
+            val y = model.predictPrior(key).battery + 0.5
+            val before = cache
+            val result = AugeLearner.update(cache, observation(index + 1, y).copy(anchorMs = inputs.nowMs,
+                observedAtMs = inputs.nowMs, relevantLogId = log.id), model)
+            cache = result.cache
+            transitions += AugeModelSkill.rollbacks(before, cache).size
+        }
+        assertEquals(1, transitions)
+        assertTrue(cache.parameterStates.getValue(key).frozen)
+        assertEquals(exp(prior.mean), cache.cnsRecoveryHours!!, 1e-12)
+    }
+}
