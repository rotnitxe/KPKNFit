+    @Test
+    fun criterioA_sinDeriva_pectoralesYColumna_30ObsPropias() {
+        // En una corrida con suficientes gestos (100 gestos, 26 semanas), Pectorales y Columna alcanzan 30 obs propias
+        val scenario = AugeLearnerSimulator.SCENARIOS[0]
+        val users = AugeSyntheticUserHarness.learnerUsers(count = if (AugeSyntheticUserHarness.isFullMode()) 60 else 20, weeks = 26)
+        println("[CRITERIO-A-LARGO] Evaluando Pectorales y Columna a 30 obs propias con ${users.size} usuarios...")
+
+        val runs = AugeLearnerSimulator.runPopulation(
+            users = users,
+            scenarios = listOf(scenario),
+            gestures = 100,
+            learnerFactory = { EkfSimLearner() },
+        ).getValue(scenario.name)
+
+        val muscleParam = AugeLearnerSimulator.muscleParam("Pectorales")
+        val spinalParam = AugeLearnerSimulator.SPINAL
+        val params = listOf(muscleParam, spinalParam)
+
+        val metrics = AugeLearnerSimulator.metricsByOwnObservations(runs, scenario, params, milestones = listOf(30))
+        for (m in metrics) {
+            val biasPct = abs(m.bias) / m.trueTau
+            println(
+                "[CRITERIO-A-LARGO] ${m.param} tras 30 obs propias: trueTau=${f1(m.trueTau)} h, " +
+                    "MAE=${f2(m.mae)} h, sesgo=${f2(m.bias)} h (|sesgo|/τ=${f4(biasPct)}), usuarios=${m.users}",
+            )
+            assertTrue(
+                "Criterio (a) Sin deriva ${m.param}: |sesgo|/τ debe ser <= 0,05 (medido: ${f4(biasPct)})",
+                biasPct <= 0.05,
+            )
+        }
+    }
