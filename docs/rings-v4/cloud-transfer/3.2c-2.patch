+            AugeSyntheticUserHarness.completedExercise("sim-inclinado", 3, 10, 26.0, 8.0, 120, "$id-i"),
+        )
+        return AugeSyntheticUserHarness.logFor(
+            id = id,
+            sessionName = "Empuje",
+            exercises = exercises,
+            completionMs = completionMs,
+            durationMinutes = 50,
+            priorHistory = priorHistory,
+            settings = settings,
+        )
+    }
