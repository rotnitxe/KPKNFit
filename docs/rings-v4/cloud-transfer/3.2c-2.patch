+    // ═══════════════════════════════════════════════════════════════════════════
+    // CRITERIO (g): Apilado (historias de 2 y 3 sesiones separadas 24 h)
+    // ═══════════════════════════════════════════════════════════════════════════
+
+    @Test
+    fun criterioG_apilado_sesionesSeparadas24h_sesgoMenor10PctYNingunAjusteSoloUltimaCarga() {
+        val muscle = "Pectorales"
+        val muscleKey = AugeAdaptiveCacheMigration.parameterKey(muscle)
+        val trueTau = 48.0
+        val baseMs = AugeSyntheticUserHarness.BASE_START_MS
+
+        // Caso 1: 2 sesiones separadas 24 h
+        val s1_1 = benchSession("s1-1", baseMs)
+        val s1_2 = benchSession("s1-2", baseMs + 24L * HOUR_MS, listOf(s1_1))
+        val history2 = listOf(s1_1, s1_2)
+        val tObs2 = baseMs + 48L * HOUR_MS // 24 h tras la última sesión
+
+        val inputs2 = AugeSnapshotInputs(history2, null, settings, exerciseDb, tObs2, ZONE)
+        val model2 = SnapshotObservationModel(inputs2, tObs2, ObservationScale.HISTORICAL_RAW)
+        val y2 = model2.predict(muscleKey, ln(trueTau)).battery
+
+        val obs2 = AugeLearningObservation(
+            parameterKey = muscleKey,
+            y = y2,
+            sigma = AugeParameters.LEARNER_SIGMA_MANUAL,
+            source = "manual",
+            anchorMs = tObs2,
+            observedAtMs = tObs2,
+            relevantLogId = s1_2.id,
+            hoursSinceRelevantLoad = 24.0,
+        )
+        val res2 = AugeLearner.update(AugeAdaptiveCache(), obs2, model2)
+        val tauLearned2 = exp(res2.cache.parameterStates[muscleKey]?.mean ?: ln(trueTau))
+        val biasPct2 = abs(tauLearned2 - trueTau) / trueTau
+        println("[CRITERIO-G] 2 sesiones: trueTau=$trueTau h, tauLearned=${f2(tauLearned2)} h, biasPct=${f4(biasPct2)}")
+        assertTrue("Criterio (g) 2 sesiones |sesgo|/τ <= 0,10 (medido: $biasPct2)", biasPct2 <= 0.10)
+
+        // Caso 2: 3 sesiones separadas 24 h
+        val s2_1 = benchSession("s2-1", baseMs)
+        val s2_2 = benchSession("s2-2", baseMs + 24L * HOUR_MS, listOf(s2_1))
+        val s2_3 = benchSession("s2-3", baseMs + 48L * HOUR_MS, listOf(s2_1, s2_2))
+        val history3 = listOf(s2_1, s2_2, s2_3)
+        val tObs3 = baseMs + 72L * HOUR_MS // 24 h tras la última sesión
+
+        val inputs3 = AugeSnapshotInputs(history3, null, settings, exerciseDb, tObs3, ZONE)
+        val model3 = SnapshotObservationModel(inputs3, tObs3, ObservationScale.HISTORICAL_RAW)
+        val y3 = model3.predict(muscleKey, ln(trueTau)).battery
+
+        val obs3 = AugeLearningObservation(
+            parameterKey = muscleKey,
+            y = y3,
+            sigma = AugeParameters.LEARNER_SIGMA_MANUAL,
+            source = "manual",
+            anchorMs = tObs3,
+            observedAtMs = tObs3,
+            relevantLogId = s2_3.id,
+            hoursSinceRelevantLoad = 24.0,
+        )
+        val res3 = AugeLearner.update(AugeAdaptiveCache(), obs3, model3)
+        val tauLearned3 = exp(res3.cache.parameterStates[muscleKey]?.mean ?: ln(trueTau))
+        val biasPct3 = abs(tauLearned3 - trueTau) / trueTau
+        println("[CRITERIO-G] 3 sesiones: trueTau=$trueTau h, tauLearned=${f2(tauLearned3)} h, biasPct=${f4(biasPct3)}")
+        assertTrue("Criterio (g) 3 sesiones |sesgo|/τ <= 0,10 (medido: $biasPct3)", biasPct3 <= 0.10)
+
+        // Comprobación: un ajuste basado solo en la última carga sufriría un sesgo severo
+        val lastStress = s2_3.muscularImpactV2?.perMuscle?.getValue("Pectorales")?.stressUnits ?: 100.0
+        val naiveObs = com.example.kpkn.data.models.RecoveryLearningObservation(
+            muscle = "Pectorales",
+            predictedBattery = 75,
+            actualBattery = y3.roundToInt(),
+            sessionStress = lastStress,
+            hoursSinceSession = 24.0,
+        )
+        val impliedNaive = LegacyEmaReference.deriveImpliedRecoveryTime(naiveObs)
+        if (impliedNaive != null) {
+            val naiveBiasPct = abs(impliedNaive - trueTau) / trueTau
+            println("[CRITERIO-G] Inversión ingenua basada solo en última carga: implied=${f2(impliedNaive)} h, biasPct=${f4(naiveBiasPct)}")
+            assertTrue("La inversión ingenua sobre la última carga debe desviar fuertemente", naiveBiasPct > 0.20)
+        }
+    }
