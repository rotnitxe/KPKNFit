+                    )
+                }
+            }
+        }
+
+        reportBuilder.append("\n## 2. Desglose por hitos de gestos (@8, @16, @30)\n\n")
+        reportBuilder.append("| Escenario | Parámetro | Hito gestos | MAE EMA (h) | Sesgo EMA (h) | MAE EKF (h) | Sesgo EKF (h) | MAE% EKF | n adm EKF | Cens EKF |\n")
+        reportBuilder.append("|---|---|---|---|---|---|---|---|---|---|\n")
+
