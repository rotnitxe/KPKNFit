+    // ═══════════════════════════════════════════════════════════════════════════
+    // CRITERIO (b): Convergencia (200 usuarios por escenario)
+    // ═══════════════════════════════════════════════════════════════════════════
+
+    @Test
+    fun criterioB_convergencia_200UsuariosPorEscenario() {
+        val factors = listOf(0.75, 1.25)
+        val userCount = 200
+        val muscle = "Pectorales"
+        val muscleKey = AugeAdaptiveCacheMigration.parameterKey(muscle)
+        val priorTau = AugeParameters.baseTauHours(muscleKey)
+        val sigmaNoise = 5.0
+
+        for (factor in factors) {
+            val trueTau = priorTau * factor
+            val lnTrue = ln(trueTau)
+
+            println("\n[CRITERIO-B] === Escenario factor $factor (τ verdadero = ${f1(trueTau)} h, prior = ${f1(priorTau)} h) ===")
+
+            // Simulación paralela de 200 usuarios con calendario fijado por semilla
+            val userResults = AugeSyntheticUserHarness.parallelMap((0 until userCount).toList()) { userIndex ->
+                val rng = Random(seed = 100_000L * (if (factor > 1.0) 2 else 1) + 7919L * userIndex)
+
+                val ekfLearner = EkfSimLearner()
+                val emaLearner = CurrentEmaLearner()
+
+                val history = ArrayList<WorkoutLog>()
+                val baseMs = AugeSyntheticUserHarness.BASE_START_MS
+
+                // 8 sesiones informativas separadas ≥ 2 días (72 h) con Δt entre 12 y 72 h
+                for (k in 0 until 8) {
+                    val sessionStart = baseMs + k * 3L * DAY_MS
+                    val sessionEnd = sessionStart + 50 * 60_000L
+                    val sessionLog = benchSession("u$userIndex-s$k", sessionEnd, history)
+                    history.add(sessionLog)
+
+                    // Calendario fijado por semilla: Δt entre 12 y 72 h tras la sesión
+                    val deltaTHours = 12.0 + rng.nextDouble() * 60.0
+                    val obsTime = sessionEnd + (deltaTHours * HOUR_MS).toLong()
+
+                    // Modelo de verdad
+                    val trueInputs = AugeSnapshotInputs(
+                        history = history,
+                        wellbeing = null,
+                        settings = settings,
+                        exerciseDb = exerciseDb,
+                        nowMs = obsTime,
+                        zone = ZONE,
+                    )
+                    val trueModel = SnapshotObservationModel(trueInputs, obsTime, ObservationScale.HISTORICAL_RAW)
+                    val trueVal = trueModel.predict(muscleKey, lnTrue).battery
+
+                    // Sentido con ruido σ = 5.0
+                    val felt = (trueVal + sigmaNoise * gaussian(rng)).roundToInt().coerceIn(0, 100)
+
+                    // Predicción para EMA
+                    val capacity = AugeLearnerSimulator.muscleCapacity(settings, exerciseDb, muscle, history, obsTime)
+                    val emaPred = AugeLearnerSimulator.muscleBattery(settings, exerciseDb, muscle, history, obsTime, emaLearner.cache(), capacity)
+
+                    val gesture = SimGesture(
+                        tiempoMs = obsTime,
+                        observaciones = listOf(
+                            SimObservation(SimChannel.MUSCLE, muscle, felt, emaPred),
+                        ),
+                        historial = history,
+                        ajustes = settings,
+                        exerciseDb = exerciseDb,
+                        zona = ZONE,
+                    )
+
+                    ekfLearner.onGesture(gesture)
+                    emaLearner.onGesture(gesture)
+                }
+
+                val tauEkf = AugeLearnerSimulator.tauOf(ekfLearner.cache(), muscleKey)
+                val tauEma = AugeLearnerSimulator.tauOf(emaLearner.cache(), muscleKey)
+
+                val errEkf = abs(ln(tauEkf / trueTau))
+                val errEma = abs(ln(tauEma / trueTau))
+
+                Pair(errEkf, errEma)
+            }
+
+            val ekfErrors = userResults.map { it.first }.sorted()
+            val emaErrors = userResults.map { it.second }.sorted()
+
+            val p50Ekf = percentile(ekfErrors, 50.0)
+            val p75Ekf = percentile(ekfErrors, 75.0)
+            val p90Ekf = percentile(ekfErrors, 90.0)
+            val pct15Ekf = ekfErrors.count { it <= 0.15 } * 100.0 / userCount
+
+            val p50Ema = percentile(emaErrors, 50.0)
+            val p75Ema = percentile(emaErrors, 75.0)
+            val p90Ema = percentile(emaErrors, 90.0)
+            val pct15Ema = emaErrors.count { it <= 0.15 } * 100.0 / userCount
+
+            println("[CRITERIO-B] factor=$factor EKF: p50=${f4(p50Ekf)}, p75=${f4(p75Ekf)}, p90=${f4(p90Ekf)}, %<=0.15=${f1(pct15Ekf)}%")
+            println("[CRITERIO-B] factor=$factor EMA: p50=${f4(p50Ema)}, p75=${f4(p75Ema)}, p90=${f4(p90Ema)}, %<=0.15=${f1(pct15Ema)}%")
+
+            assertTrue("Criterio (b) factor=$factor: mediana EKF <= 0,15 (medida: ${f4(p50Ekf)})", p50Ekf <= 0.15)
+            assertTrue("Criterio (b) factor=$factor: p75 EKF <= 0,25 (medida: ${f4(p75Ekf)})", p75Ekf <= 0.25)
+            assertTrue("Criterio (b) factor=$factor: mediana EKF estrictamente mejor que EMA ($p50Ekf vs $p50Ema)", p50Ekf < p50Ema)
+            assertTrue("Criterio (b) factor=$factor: p75 EKF estrictamente mejor que EMA ($p75Ekf vs $p75Ema)", p75Ekf < p75Ema)
+        }
+    }
