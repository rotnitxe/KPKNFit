index 0000000000000000000000000000000000000000..a9ee417b3c4c23ecf65c4dd6a564ebd96fc2a233
--- /dev/null
+++ b/android-native/app/src/test/java/com/example/kpkn/domain/auge/EkfSimLearner.kt
@@ -0,0 +1,200 @@
+package com.example.kpkn.domain.auge
+
+import com.example.kpkn.data.models.AugeAdaptiveCache
+import com.example.kpkn.data.models.AugeObservationStatus
+import com.example.kpkn.data.models.ExerciseMuscleInfo
+import com.example.kpkn.data.models.Settings
+import com.example.kpkn.data.models.WorkoutLog
+
+/**
+ * Adaptador del aprendiz EKF ([AugeLearner]) a la interfaz [SimLearner] del simulador.
+ *
+ * Por cada gesto construye un [SnapshotObservationModel] con las entradas causales anteriores al gesto
+ * ([SimGesture.historial], [SimGesture.ajustes], [SimGesture.exerciseDb], [SimGesture.zona]) y el caché
+ * previo del aprendiz, sin el ancla del propio gesto.
+ *
+ * Todas las observaciones del gesto comparten ese contexto anterior, combinando sus posteriores
+ * independientes sin pisarse.
+ *
+ * La escala por defecto es [ObservationScale.HISTORICAL_RAW], que preserva la familia histórica
+ * con Columna CRUDA (`continuous.spineRaw`) comparable con la línea base de 2.2b2.
+ */
+class EkfSimLearner(
+    initial: AugeAdaptiveCache = AugeAdaptiveCache(),
+    private val scale: ObservationScale = ObservationScale.HISTORICAL_RAW,
+) : SimLearner {
+
+    private var current: AugeAdaptiveCache = initial
+
+    /** Diagnósticos del último gesto procesado (para inspección y auditoría de pruebas). */
+    var lastResults: List<AugeLearnerResult> = emptyList()
+        private set
+
+    /** Observaciones presentadas por clave (incluye las que el filtro censura). */
+    val presentedByParam: MutableMap<String, Int> = HashMap()
+
+    /** Observaciones ADMITIDAS por clave (n del posterior), para publicar n junto a las métricas. */
+    val admittedByParam: MutableMap<String, Int> = HashMap()
+
+    /** Observaciones CENSURADAS por clave, con el motivo del último rechazo. */
+    val censoredByParam: MutableMap<String, Int> = HashMap()
+    val censoredReasons: MutableMap<String, Int> = HashMap()
+    val censoredAtOwnObs: MutableMap<String, MutableMap<Int, Int>> = HashMap()
+    val admittedAtGestures: MutableMap<String, MutableMap<Int, Int>> = HashMap()
+    val censoredAtGestures: MutableMap<String, MutableMap<Int, Int>> = HashMap()
+    private var gestureCount = 0
+
+    /** n ADMITIDO al alcanzar 8/16/30 observaciones propias presentadas, por clave (diagnóstico de las compuertas). */
+    val admittedAtOwnObs: MutableMap<String, MutableMap<Int, Int>> = HashMap()
+
+    private companion object {
+        val OWN_OBS_MILESTONES = listOf(8, 16, 30)
+    }
+
+    override fun cache(): AugeAdaptiveCache = current
+
+    override fun onGesture(gesto: SimGesture) {
+        val cacheBeforeGesture = current
+        val inputsAntesDelGesto = AugeSnapshotInputs(
+            history = gesto.historial,
+            wellbeing = null,
+            settings = gesto.ajustes,
+            exerciseDb = gesto.exerciseDb,
+            nowMs = gesto.tiempoMs,
+            zone = gesto.zona,
+            adaptiveCache = cacheBeforeGesture,
+        )
+        val model = SnapshotObservationModel(
+            inputsBeforeGesture = inputsAntesDelGesto,
+            observedAtMs = gesto.tiempoMs,
+            scale = scale,
+        )
+
+        var runningCache = current
+        val results = ArrayList<AugeLearnerResult>(gesto.observaciones.size)
+
+        for (obs in gesto.observaciones) {
+            val canonicalKey = when (obs.channel) {
+                SimChannel.ENERGY -> "cns"
+                SimChannel.SPINAL -> "spinal"
+                SimChannel.MUSCLE -> AugeAdaptiveCacheMigration.parameterKey(obs.muscle)
+            }
+
+            val relevantLog = findRelevantLog(gesto, obs.channel, canonicalKey)
+            val hoursSince = if (relevantLog != null) {
+                val logMs = AugeUtils.logDateMs(relevantLog)
+                if (logMs > 0L && logMs <= gesto.tiempoMs) {
+                    (gesto.tiempoMs - logMs) / 3_600_000.0
+                } else {
+                    AugeParameters.LEARNER_WINDOW_MAX_HOURS + 1.0
+                }
+            } else {
+                AugeParameters.LEARNER_WINDOW_MAX_HOURS + 1.0
+            }
+
+            val learningObs = AugeLearningObservation(
+                parameterKey = canonicalKey,
+                y = obs.sentido.toDouble(),
+                sigma = AugeParameters.LEARNER_SIGMA_MANUAL,
+                source = "manual",
+                anchorMs = gesto.tiempoMs,
+                observedAtMs = gesto.tiempoMs,
+                relevantLogId = relevantLog?.id,
+                hoursSinceRelevantLoad = hoursSince,
+            )
+
+            val result = AugeLearner.update(runningCache, learningObs, model)
+            runningCache = result.cache
+            results += result
+        }
+
+        current = runningCache
+        lastResults = results
+
+        // Diagnóstico: presentadas, admitidas y censuradas por clave (mismo orden que las observaciones).
+        gesto.observaciones.forEachIndexed { index, obs ->
+            val key = keyOf(obs.channel, obs.muscle)
+            val presented = (presentedByParam[key] ?: 0) + 1
+            presentedByParam[key] = presented
+            when (results.getOrNull(index)?.outcome?.status) {
+                AugeObservationStatus.ADMITTED -> admittedByParam[key] = (admittedByParam[key] ?: 0) + 1
+                AugeObservationStatus.CENSORED -> {
+                    censoredByParam[key] = (censoredByParam[key] ?: 0) + 1
+                    val reason = results[index].outcome.reason ?: "sin_motivo"
+                    censoredReasons[reason] = (censoredReasons[reason] ?: 0) + 1
+                }
+                else -> Unit
+            }
+            if (presented in OWN_OBS_MILESTONES) {
+                admittedAtOwnObs.getOrPut(key) { HashMap() }[presented] =
+                    runningCache.parameterStates[key]?.n ?: 0
+                censoredAtOwnObs.getOrPut(key) { HashMap() }[presented] =
+                    censoredByParam[key] ?: 0
+            }
+        }
+
+        gestureCount++
+        if (gestureCount in OWN_OBS_MILESTONES) {
+            val allKeys = (listOf("cns", "spinal", "pectorales") + runningCache.personalizedRecoveryHours.keys + presentedByParam.keys).distinct()
+            for (key in allKeys) {
+                admittedAtGestures.getOrPut(key) { HashMap() }[gestureCount] =
+                    runningCache.parameterStates[key]?.n ?: 0
+                censoredAtGestures.getOrPut(key) { HashMap() }[gestureCount] =
+                    censoredByParam[key] ?: 0
+            }
+        }
+    }
+
+    private fun keyOf(channel: SimChannel, muscle: String): String = when (channel) {
+        SimChannel.ENERGY -> "cns"
+        SimChannel.SPINAL -> "spinal"
+        SimChannel.MUSCLE -> AugeAdaptiveCacheMigration.parameterKey(muscle)
+    }
+
+    private fun findRelevantLog(
+        gesto: SimGesture,
+        channel: SimChannel,
+        canonicalKey: String,
+    ): WorkoutLog? = when (channel) {
+        SimChannel.ENERGY -> gesto.historial
+            .filter { val ms = AugeUtils.logDateMs(it); ms > 0L && ms <= gesto.tiempoMs }
+            .maxByOrNull { AugeUtils.logDateMs(it) }
+        SimChannel.SPINAL -> gesto.historial
+            .filter {
+                val ms = AugeUtils.logDateMs(it)
+                ms > 0L && ms <= gesto.tiempoMs &&
+                    PerformanceTauLearner.sessionHasAxialStimulus(it.completedExercises, gesto.exerciseDb)
+            }
+            .maxByOrNull { AugeUtils.logDateMs(it) }
+        SimChannel.MUSCLE -> gesto.historial
+            .filter {
+                val ms = AugeUtils.logDateMs(it)
+                ms > 0L && ms <= gesto.tiempoMs &&
+                    sessionTrainedMuscle(it, canonicalKey, gesto.ajustes, gesto.exerciseDb)
+            }
+            .maxByOrNull { AugeUtils.logDateMs(it) }
+    }
+
+    private fun sessionTrainedMuscle(
+        log: WorkoutLog,
+        canonicalKey: String,
+        settings: Settings,
+        exerciseDb: Map<String, ExerciseMuscleInfo>,
+    ): Boolean {
+        val impact = log.muscularImpactV2?.perMuscle?.entries
+            ?.firstOrNull { AugeAdaptiveCacheMigration.parameterKey(it.key) == canonicalKey }
+            ?.value
+        val fromImpact = impact?.immediateDrainPct?.takeIf { it > 0.0 }
+            ?: impact?.stressUnits?.takeIf { it > 0.0 }
+        if (fromImpact != null) return true
+        if (log.muscularImpactV2 != null) return false
+        val computed = AugeRecoveryEngine.calculateMuscleSessionStress(
+            muscleName = canonicalKey,
+            log = log,
+            settings = settings,
+            exerciseDb = exerciseDb,
+            adaptiveCache = AugeAdaptiveCache(),
+        )
+        return computed > 0.0
+    }
+}
