+    @Test
+    fun criterioA_sinDeriva_tauVerdaderoIgualPrior_sesgoMenor5PctTras30Obs() {
+        val scenario = AugeLearnerSimulator.SCENARIOS[0] // "tau verdadero = defecto", factor 1.0, sigma 4.0
+        val users = AugeSyntheticUserHarness.learnerUsers()
+        println("[CRITERIO-A] Evaluando sin deriva con ${users.size} usuarios (modo full=${AugeSyntheticUserHarness.isFullMode()})...")
+
+        val runs = AugeLearnerSimulator.runPopulation(
+            users = users,
+            scenarios = listOf(scenario),
+            gestures = 30,
+            learnerFactory = { EkfSimLearner() },
+        ).getValue(scenario.name)
+
+        // En 30 gestos, el canal de Energía (cns) recibe 30 observaciones propias
+        val cnsMetrics = AugeLearnerSimulator.metricsByOwnObservations(runs, scenario, listOf("cns"), milestones = listOf(30))
+        val cnsObs30 = cnsMetrics.firstOrNull { it.n == 30 }
+        requireNotNull(cnsObs30) { "No se obtuvieron métricas de CNS a 30 observaciones propias" }
+
+        val cnsBiasPct = abs(cnsObs30.bias) / cnsObs30.trueTau
+        println(
+            "[CRITERIO-A] CNS tras 30 obs propias: trueTau=${f1(cnsObs30.trueTau)} h, " +
+                "MAE=${f2(cnsObs30.mae)} h, sesgo=${f2(cnsObs30.bias)} h (|sesgo|/τ=${f4(cnsBiasPct)}), " +
+                "usuarios=${cnsObs30.users}",
+        )
+
+        // Publicar error por usuario y n admitido
+        val errorsPerUser = runs.mapNotNull { it.tauAtOwnObs["cns"]?.get(30) }.map { it - cnsObs30.trueTau }
+        println("[CRITERIO-A] Errores por usuario en CNS (primeros 10): ${errorsPerUser.take(10).map { f2(it) }}")
+        assertTrue(
+            "Criterio (a) Sin deriva: CNS |sesgo|/τ debe ser <= 0,05 (medido: ${f4(cnsBiasPct)})",
+            cnsBiasPct <= 0.05,
+        )
+    }
