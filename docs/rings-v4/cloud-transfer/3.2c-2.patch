+    // ═══════════════════════════════════════════════════════════════════════════
+    // COMPARACIÓN HONESTA: EMA vigente vs EKF (4 escenarios)
+    // ═══════════════════════════════════════════════════════════════════════════
+
+    @Test
+    fun comparacionHonesta_referenciaEmaVigenteVsEkf_cuatroEscenarios() {
+        val users = AugeSyntheticUserHarness.learnerUsers()
