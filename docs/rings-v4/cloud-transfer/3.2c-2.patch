+            AugeLearnerSimulator.SCENARIOS[1].name to mapOf(muscleParam to "5,2 / −4,4", cnsParam to "9,4 / −9,4", spinalParam to "14,3 / +14,2"),
+            AugeLearnerSimulator.SCENARIOS[2].name to mapOf(muscleParam to "17,4 / +17,4", cnsParam to "3,4 / +3,0", spinalParam to "34,5 / +34,5"),
+            AugeLearnerSimulator.SCENARIOS[3].name to mapOf(muscleParam to "7,7 / +7,2", cnsParam to "2,9 / −1,3", spinalParam to "25,1 / +25,1"),
