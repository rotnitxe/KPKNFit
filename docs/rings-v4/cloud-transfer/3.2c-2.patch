+/**
+ * Pruebas de simulación del aprendiz EKF ([AugeLearner] vía [EkfSimLearner]):
+ *
+ * Validación numérica con el motor real de los criterios del plan 6.6 y brief 3.2:
+ * - (a) Sin deriva: τ verdadero = prior ⇒ |sesgo de τ|/τ ≤ 0,05 tras 30 observaciones propias;
+ *       y = h sin ruido ⇒ 0 cambio de media/P/n.
+ * - (b) Convergencia: 200 usuarios por escenario, τ verdadero = prior × {0,75; 1,25}, σ = 5,
+ *       8 observaciones informativas separadas ≥ 2 días con Δt entre 12 y 72 h (calendario fijo):
+ *       mediana de |ln(τ̂/τ)| ≤ 0,15 y p75 ≤ 0,25, estrictamente mejores que el EMA.
+ * - (g) Apilado: historias con 2 y 3 sesiones separadas 24 h: |sesgo|/τ ≤ 0,10 y ningún ajuste
+ *       basado solo en la última carga.
+ * - Familia «Columna mostrada»: bloqueo articular censura («piso_o_bloqueo») y τ no cambia.
+ * - Comparación honesta con la referencia EMA vigente en los 4 escenarios de la auditoría.
+ */
+class AugeLearnerSimulationTest {
+
+    private companion object {
+        const val HOUR_MS = AugeSyntheticUserHarness.HOUR_MS
+        const val DAY_MS = AugeSyntheticUserHarness.DAY_MS
+        val ZONE: ZoneId = ZoneId.of("UTC")
+        val exerciseDb = AugeSyntheticUserHarness.exerciseDb
+        val settings = Settings()
+
+        fun f1(v: Double): String = String.format(Locale.ROOT, "%.1f", v)
+        fun f2(v: Double): String = String.format(Locale.ROOT, "%.2f", v)
+        fun f4(v: Double): String = String.format(Locale.ROOT, "%.4f", v)
+
+        fun gaussian(rng: Random): Double {
+            val u1 = rng.nextDouble().coerceAtLeast(1e-12)
+            val u2 = rng.nextDouble()
+            return sqrt(-2.0 * ln(u1)) * cos(2.0 * PI * u2)
+        }
+
+        fun percentile(sortedValues: List<Double>, p: Double): Double {
+            if (sortedValues.isEmpty()) return Double.NaN
+            val idx = (p / 100.0) * (sortedValues.size - 1)
+            val lower = idx.toInt()
+            val upper = minOf(lower + 1, sortedValues.size - 1)
+            val weight = idx - lower
+            return sortedValues[lower] * (1.0 - weight) + sortedValues[upper] * weight
+        }
+    }
+
+    private fun benchSession(
+        id: String,
+        completionMs: Long,
+        priorHistory: List<WorkoutLog> = emptyList(),
+    ): WorkoutLog {
+        val exercises = listOf(
