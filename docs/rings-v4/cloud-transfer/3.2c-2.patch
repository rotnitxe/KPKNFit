+        reportBuilder.append("Referencia publicada (2.2b2) → EMA con motor vigente → EKF.\n\n")
+
+        reportBuilder.append("## 1. Resumen comparativo a 30 gestos\n\n")
+        reportBuilder.append("| Escenario | Parámetro | Ref 2.2b2 MAE/sesgo | EMA vigente MAE/sesgo | EKF MAE/sesgo | MAE% EKF | Away% EMA→EKF | n admitido | Censuras |\n")
+        reportBuilder.append("|---|---|---|---|---|---|---|---|---|\n")
+
+        for (scenario in AugeLearnerSimulator.SCENARIOS) {
+            val emaRuns = emaRunsByScenario.getValue(scenario.name)
+            val ekfRuns = ekfRunsByScenario.getValue(scenario.name)
+            val ekfLearners = ekfLearnersByScenario.getValue(scenario.name)
+
+            val emaMetrics30 = AugeLearnerSimulator.metrics(emaRuns, scenario, trackedParams, milestones = listOf(30)).associateBy { it.param }
+            val ekfMetrics30 = AugeLearnerSimulator.metrics(ekfRuns, scenario, trackedParams, milestones = listOf(30)).associateBy { it.param }
+
+            val emaAway = AugeLearnerSimulator.awayStats(emaRuns, scenario) { trackedParams.contains(it) }
+            val ekfAway = AugeLearnerSimulator.awayStats(ekfRuns, scenario) { trackedParams.contains(it) }
+
+            println("\n--- Escenario: ${scenario.name} ---")
+            println("Away stats: EMA=${f1(emaAway.pct)}% (${emaAway.away}/${emaAway.counted}) -> EKF=${f1(ekfAway.pct)}% (${ekfAway.away}/${ekfAway.counted})")
+
+            for (param in trackedParams) {
+                val emaM = emaMetrics30.getValue(param)
+                val ekfM = ekfMetrics30.getValue(param)
+                val refStr = ref22b2[scenario.name]?.get(param) ?: "-"
+                val maePctEkf = (ekfM.mae / ekfM.trueTau) * 100.0
+
+                val signEkf = if (ekfM.bias >= 0) "+" else ""
+                val signEma = if (emaM.bias >= 0) "+" else ""
+
+                val meanAdmitted = ekfLearners.map { it.admittedAtGestures[param]?.get(30) ?: (it.admittedByParam[param] ?: 0) }.average()
+                val meanCensored = ekfLearners.map { it.censoredAtGestures[param]?.get(30) ?: (it.censoredByParam[param] ?: 0) }.average()
+
+                println(
+                    "[$param] Ref 2.2b2: $refStr | EMA: ${f1(emaM.mae)} / $signEma${f1(emaM.bias)} h | " +
+                        "EKF: ${f1(ekfM.mae)} / $signEkf${f1(ekfM.bias)} h (MAE%=${f1(maePctEkf)}%) | n_adm=${f1(meanAdmitted)} cens=${f1(meanCensored)}",
+                )
+
+                reportBuilder.append(
+                    "| ${scenario.name} | $param | $refStr | ${f1(emaM.mae)} / $signEma${f1(emaM.bias)} h | " +
+                        "${f1(ekfM.mae)} / $signEkf${f1(ekfM.bias)} h | ${f1(maePctEkf)}% | ${f1(emaAway.pct)}% → ${f1(ekfAway.pct)}% | ${f1(meanAdmitted)} | ${f1(meanCensored)} |\n",
+                )
+
+                // En τ = prior: sesgo <= 5% de trueTau y MAE EKF < MAE EMA
