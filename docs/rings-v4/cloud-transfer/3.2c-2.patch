+    // CRITERIO (a): Sin deriva
+    // ═══════════════════════════════════════════════════════════════════════════
+
+    @Test
+    fun criterioA_sinRuidoYIgualH_ceroCambioMediaP_N() {
+        val baseMs = AugeSyntheticUserHarness.BASE_START_MS
+        val log = benchSession("log1", baseMs)
+        val tObs = baseMs + 24L * HOUR_MS
+
+        val inputs = AugeSnapshotInputs(
+            history = listOf(log),
+            wellbeing = null,
+            settings = settings,
+            exerciseDb = exerciseDb,
+            nowMs = tObs,
+            zone = ZONE,
+        )
+        val model = SnapshotObservationModel(inputs, tObs, ObservationScale.HISTORICAL_RAW)
+
+        val paramsToTest = listOf("cns", "spinal", "Pectorales")
+        for (param in paramsToTest) {
+            val key = AugeAdaptiveCacheMigration.parameterKey(param)
+            val prior = AugeAdaptiveCacheMigration.prior(key)
+            val pred = model.predict(key, prior.mean)
+
+            // Sin ruido: y = h exactamente
+            val obs = AugeLearningObservation(
+                parameterKey = key,
+                y = pred.battery,
+                sigma = AugeParameters.LEARNER_SIGMA_MANUAL,
+                source = "manual",
+                anchorMs = tObs,
+                observedAtMs = tObs,
+                relevantLogId = log.id,
+                hoursSinceRelevantLoad = 24.0,
+            )
+
+            val initialCache = AugeAdaptiveCache()
+            val result = AugeLearner.update(initialCache, obs, model)
+
+            assertEquals("$key debe ser censurada por zona muerta", AugeObservationStatus.CENSORED, result.outcome.status)
+            assertEquals("$key motivo de censura", "zona_muerta", result.outcome.reason)
+            val stateAfter = result.cache.parameterStates.getValue(key)
+            assertEquals("media de $key no cambia", prior.mean, stateAfter.mean, 1e-9)
+            assertEquals("varianza de $key no cambia", prior.variance, stateAfter.variance, 1e-9)
+            assertEquals("n de $key es 0", 0, stateAfter.n)
+            assertEquals("tau de $key no cambia", AugeLearnerSimulator.defaultTau(key), AugeLearnerSimulator.tauOf(result.cache, key), 1e-9)
+        }
+    }
