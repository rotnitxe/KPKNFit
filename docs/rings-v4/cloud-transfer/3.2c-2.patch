+                        reportBuilder.append(
+                            "| ${scenario.name} | $param | @$n | ${f1(emaM.mae)} | $signEma${f1(emaM.bias)} | " +
+                                "${f1(ekfM.mae)} | $signEkf${f1(ekfM.bias)} | ${f1(maePct)}% | ${f1(nAdm)} | ${f1(cens)} |\n",
+                        )
+                    }
+                }
+            }
+        }
+
+        reportBuilder.append("\n## 3. Desglose por observaciones propias presentadas (@8, @16, @30)\n\n")
+        reportBuilder.append("| Escenario | Parámetro | Hito obs propias | MAE EMA (h) | Sesgo EMA (h) | MAE EKF (h) | Sesgo EKF (h) | MAE% EKF | n adm EKF | Cens EKF |\n")
+        reportBuilder.append("|---|---|---|---|---|---|---|---|---|---|\n")
+
+        for (scenario in AugeLearnerSimulator.SCENARIOS) {
+            val emaRuns = emaRunsByScenario.getValue(scenario.name)
+            val ekfRuns = ekfRunsByScenario.getValue(scenario.name)
+            val ekfLearners = ekfLearnersByScenario.getValue(scenario.name)
+
+            val emaMetricsOwn = AugeLearnerSimulator.metricsByOwnObservations(emaRuns, scenario, trackedParams, milestones = ownObsMilestones)
+                .groupBy { it.param }
+            val ekfMetricsOwn = AugeLearnerSimulator.metricsByOwnObservations(ekfRuns, scenario, trackedParams, milestones = ownObsMilestones)
+                .groupBy { it.param }
+
+            for (param in trackedParams) {
+                for (n in ownObsMilestones) {
+                    val emaM = emaMetricsOwn[param]?.firstOrNull { it.n == n }
+                    val ekfM = ekfMetricsOwn[param]?.firstOrNull { it.n == n }
+                    if (emaM != null && ekfM != null) {
+                        val signEkf = if (ekfM.bias >= 0) "+" else ""
+                        val signEma = if (emaM.bias >= 0) "+" else ""
+                        val maePct = (ekfM.mae / ekfM.trueTau) * 100.0
+                        val nAdm = ekfLearners.mapNotNull { it.admittedAtOwnObs[param]?.get(n) }.let { if (it.isEmpty()) 0.0 else it.average() }
+                        val cens = ekfLearners.mapNotNull { it.censoredAtOwnObs[param]?.get(n) }.let { if (it.isEmpty()) 0.0 else it.average() }
+                        reportBuilder.append(
+                            "| ${scenario.name} | $param | @$n obs | ${f1(emaM.mae)} | $signEma${f1(emaM.bias)} | " +
+                                "${f1(ekfM.mae)} | $signEkf${f1(ekfM.bias)} | ${f1(maePct)}% | ${f1(nAdm)} | ${f1(cens)} |\n",
+                        )
+                    }
+                }
+            }
+        }
+
+        reportBuilder.append("\n## 4. Motivos de censura del filtro EKF acumulados\n\n")
+        reportBuilder.append("| Escenario | Parámetro | Presentadas | Admitidas | Censuradas | Tasa de censura |\n")
+        reportBuilder.append("|---|---|---|---|---|---|\n")
+
+        for (scenario in AugeLearnerSimulator.SCENARIOS) {
+            val ekfLearners = ekfLearnersByScenario.getValue(scenario.name)
+            for (param in trackedParams) {
+                val pres = ekfLearners.sumOf { it.presentedByParam[param] ?: 0 }
+                val adm = ekfLearners.sumOf { it.admittedByParam[param] ?: 0 }
+                val cens = ekfLearners.sumOf { it.censoredByParam[param] ?: 0 }
+                val rate = if (pres > 0) (cens.toDouble() / pres) * 100.0 else 0.0
+                reportBuilder.append("| ${scenario.name} | $param | $pres | $adm | $cens | ${f1(rate)}% |\n")
+            }
+        }
+
+        val reportStr = reportBuilder.toString()
+        println(reportStr)
+    }
+}
