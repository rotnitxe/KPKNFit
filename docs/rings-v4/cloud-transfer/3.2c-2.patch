+    // ═══════════════════════════════════════════════════════════════════════════
+    // FAMILIA «Columna mostrada» (ObservationScale.SHOWN)
+    // ═══════════════════════════════════════════════════════════════════════════
+
+    @Test
+    fun familiaColumnaMostrada_bloqueoArticularCensuraYNingunCambioDeTau() {
+        val baseMs = AugeSyntheticUserHarness.BASE_START_MS
+        val log = squatSession("sq1", baseMs)
+        val tObs = baseMs + 24L * HOUR_MS
+
+        val inputs = AugeSnapshotInputs(
+            history = listOf(log),
+            wellbeing = DailyWellbeingLog(
+                id = "wb1",
+                date = "2026-09-12",
+                preWorkoutDiscomforts = listOf("lumbar"),
+            ),
+            settings = settings,
+            exerciseDb = exerciseDb,
+            nowMs = tObs,
+            zone = ZONE,
+        )
+
+        // Con ObservationScale.SHOWN, el término articular fija el mínimo (blocked es true)
+        val modelShown = SnapshotObservationModel(inputs, tObs, ObservationScale.SHOWN)
+        val pred = modelShown.predict("spinal", ln(52.0))
+
+        println("[COLUMNA-MOSTRADA] pred battery=${f2(pred.battery)}, atFloor=${pred.atFloor}, blocked=${pred.blocked}")
+        assertTrue("El término articular debe bloquear la Columna mostrada", pred.blocked)
+
+        val obs = AugeLearningObservation(
+            parameterKey = "spinal",
+            y = 60.0,
+            sigma = AugeParameters.LEARNER_SIGMA_MANUAL,
+            source = "manual",
+            anchorMs = tObs,
+            observedAtMs = tObs,
+            relevantLogId = log.id,
+            hoursSinceRelevantLoad = 24.0,
+        )
+
+        val initialCache = AugeAdaptiveCache(spinalRecoveryHours = 52.0)
+        val res = AugeLearner.update(initialCache, obs, modelShown)
+
+        assertEquals("Debe ser censurada por piso_o_bloqueo", AugeObservationStatus.CENSORED, res.outcome.status)
+        assertEquals("Motivo piso_o_bloqueo", "piso_o_bloqueo", res.outcome.reason)
+        assertEquals("τ de columna no cambia cuando hay bloqueo", 52.0, res.cache.spinalRecoveryHours ?: 52.0, 1e-9)
+    }
