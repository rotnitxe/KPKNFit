+    fun recentSessionFindsFirstCrossingWithBisectionTolerance() {
+        // Sesión reciente (hace 2 horas) con fatiga en Pectorales.
+        val sessionMs = t0 - 2L * 3_600_000L
+        val log = WorkoutLog(
+            id = "w1", date = Instant.ofEpochMilli(sessionMs).toString(), sessionId = "s1", sessionName = "Pecho",
+            programId = "p1", durationMinutes = 45,
+            completedExercises = AugeRealSessionFixtures.completedExercises,
+        )
+        val inputs = baseInputs(history = listOf(log))
+        val evaluator = AugeProjectionEvaluator(inputs)
+        val core0 = evaluator.evaluate(0.0)
+        val initialScore = core0.perMuscle["Pectorales"]?.recoveryScore ?: 100
+        assertTrue("El score inicial debe estar bajo 90, fue $initialScore", initialScore < 90)
+
+        val res = AugeProjection.timeToThreshold(inputs, ProjectionTarget.Muscle("Pectorales"), threshold = 90)
+        assertTrue("Debe ser Reached pero fue $res", res is ProjectionResult.Reached)
+        val hours = (res as ProjectionResult.Reached).hours
+        assertTrue("Las horas deben ser positivas: $hours", hours > 0.0)
+        assertTrue("Las horas deben ser menores a 336 h: $hours", hours < 336.0)
+
+        // Verificar que en t = hours el score efectivamente cumple el umbral
+        val coreCrossing = evaluator.evaluate(hours)
+        val scoreCrossing = coreCrossing.perMuscle["Pectorales"]?.recoveryScore ?: 0
+        assertTrue("En el cruce ($hours h) el score debe ser >= 90, fue $scoreCrossing", scoreCrossing >= 90)
+
+        // Y un pelo antes del ancho de bisección (hours - 0.125 - 1e-4) aún no lo cumplía (o estaba en el borde)
+        if (hours > AugeProjection.BISECTION_TOLERANCE_HOURS) {
+            val coreBefore = evaluator.evaluate(hours - AugeProjection.BISECTION_TOLERANCE_HOURS - 1e-4)
+            val scoreBefore = coreBefore.perMuscle["Pectorales"]?.recoveryScore ?: 0
+            assertTrue("Antes del intervalo el score debe ser <= 90, fue $scoreBefore", scoreBefore <= 90)
+        }
+    }
+
+    @Test
+    fun futureLogAfterNowMsDoesNotAffectProjection() {
+        val sessionPast = t0 - 2L * 3_600_000L
+        val logPast = WorkoutLog(
+            id = "past", date = Instant.ofEpochMilli(sessionPast).toString(), sessionId = "s1", sessionName = "Pecho",
+            programId = "p1", durationMinutes = 45,
+            completedExercises = AugeRealSessionFixtures.completedExercises,
+        )
+        val sessionFuture = t0 + 10L * 3_600_000L
+        val logFuture = WorkoutLog(
+            id = "future", date = Instant.ofEpochMilli(sessionFuture).toString(), sessionId = "s2", sessionName = "Futuro",
+            programId = "p1", durationMinutes = 45,
+            completedExercises = AugeRealSessionFixtures.completedExercises,
+        )
+
+        val inputsWithoutFuture = baseInputs(history = listOf(logPast))
+        val inputsWithFuture = baseInputs(history = listOf(logPast, logFuture))
+
+        val res1 = AugeProjection.timeToThreshold(inputsWithoutFuture, ProjectionTarget.Muscle("Pectorales"), threshold = 90)
+        val res2 = AugeProjection.timeToThreshold(inputsWithFuture, ProjectionTarget.Muscle("Pectorales"), threshold = 90)
+
+        assertEquals(res1, res2)
+    }
+
+    @Test
+    fun projectHoursToNormalComputesAllThreeChannels() {
+        val sessionMs = t0 - 4L * 3_600_000L
+        val log = WorkoutLog(
+            id = "w1", date = Instant.ofEpochMilli(sessionMs).toString(), sessionId = "s1", sessionName = "Pecho",
+            programId = "p1", durationMinutes = 60,
+            completedExercises = AugeRealSessionFixtures.completedExercises,
+        )
+        val inputs = baseInputs(history = listOf(log))
+        val hoursToNormal = AugeProjection.projectHoursToNormal(inputs)
+
+        assertEquals(3, hoursToNormal.size)
+        assertTrue(hoursToNormal.containsKey(RecoveryChannelId.MUSCULAR))
+        assertTrue(hoursToNormal.containsKey(RecoveryChannelId.SYSTEM))
+        assertTrue(hoursToNormal.containsKey(RecoveryChannelId.STRUCTURE))
+    }
+
+    @Test
+    fun enrichSnapshotCorePopulatesHoursToRecoveryAndEstimatedHours() {
+        val sessionMs = t0 - 4L * 3_600_000L
+        val log = WorkoutLog(
+            id = "w1", date = Instant.ofEpochMilli(sessionMs).toString(), sessionId = "s1", sessionName = "Pecho",
+            programId = "p1", durationMinutes = 60,
+            completedExercises = AugeRealSessionFixtures.completedExercises,
+        )
+        val inputs = baseInputs(history = listOf(log))
+        val core = AugeSnapshotComputer.compute(inputs)
+
+        val enriched = AugeProjection.enrichSnapshotCore(core, inputs)
+        val pecs = enriched.perMuscle["Pectorales"]
+        assertNotNull(pecs)
+        assertTrue("hoursToRecovery debe poblarse", pecs!!.hoursToRecovery != null)
+
+        val shoulder = enriched.articular[ArticularBattery.SHOULDER]
+        assertNotNull(shoulder)
+        assertTrue("estimatedHoursToRecovery debe poblarse", shoulder!!.estimatedHoursToRecovery != null)
+    }
+}
