+/**
+ * AugeProjectionOracleTest — Oráculo numérico independiente de AugeProjection (WP 2.4).
+ *
+ * El oráculo NO usa bisección ni fórmulas analíticas: barre el motor directamente cada 5 minutos (1/12 h)
+ * desde t0 hasta el primer cruce con el score mostrado del motor, sin llamar a AugeProjection.
+ * Exige error absoluto <= 0,5 h en TODOS los casos estimables de la matriz mínima y publica máximo y media.
+ */
+class AugeProjectionOracleTest {
+    private val zone = ZoneId.of("UTC")
+    private val baseTime = Instant.parse("2026-04-10T10:00:00Z").toEpochMilli()
+
+    data class OracleResult(
+        val target: ProjectionTarget,
+        val threshold: Int,
+        val oracleHours: Double,
+        val projectionHours: Double,
+        val errorHours: Double,
+        val fixtureDescription: String,
+    )
+
+    private val recordedResults = mutableListOf<OracleResult>()
+
+    /**
+     * Barre el motor cada 5 min (1/12 h) sin llamar a AugeProjection.
+     */
+    private fun oracleFirstCrossing(
+        inputs: AugeSnapshotInputs,
+        target: ProjectionTarget,
+        threshold: Int,
+        maxHours: Double = 120.0, // Horizonte suficiente para los fixtures de prueba
+        stepHours: Double = 5.0 / 60.0, // 5 minutos exactos
+    ): Double? {
+        val t0 = inputs.nowMs
+        val frozen = inputs.copy(history = inputs.history.filter { AugeUtils.logDateMs(it) <= t0 })
+        val core0 = AugeSnapshotComputer.compute(frozen)
+        val score0 = scoreFor(core0, target) ?: return null
+        if (score0 >= threshold) return 0.0
+
+        var t = stepHours
+        while (t <= maxHours + 1e-9) {
+            val deltaMs = (t * 3_600_000.0).roundToLong()
+            val core = AugeSnapshotComputer.compute(frozen.copy(nowMs = t0 + deltaMs))
+            val s = scoreFor(core, target) ?: return null
+            if (s >= threshold) {
+                return t
+            }
+            t += stepHours
+        }
+        return null
+    }
+
+    private fun scoreFor(core: AugeSnapshotCore, target: ProjectionTarget): Int? = when (target) {
+        is ProjectionTarget.Channel -> when (target.channelId) {
+            RecoveryChannelId.MUSCULAR -> core.dashboard.channelScore(RecoveryChannelId.MUSCULAR, core.batteries.muscular)
+            RecoveryChannelId.SYSTEM -> core.dashboard.channelScore(RecoveryChannelId.SYSTEM, core.batteries.cnc)
+            RecoveryChannelId.STRUCTURE -> core.dashboard.channelScore(RecoveryChannelId.STRUCTURE, core.batteries.spinal)
+        }
+        is ProjectionTarget.Muscle -> core.perMuscle[target.muscleName]?.recoveryScore
+        is ProjectionTarget.Articular -> core.articular[target.articularBattery]?.recoveryScore
+    }
+
+    private fun testCase(
+        inputs: AugeSnapshotInputs,
+        target: ProjectionTarget,
+        threshold: Int,
+        description: String,
+        maxSweepHours: Double = 120.0,
+    ) {
+        val oracle = oracleFirstCrossing(inputs, target, threshold, maxHours = maxSweepHours)
+        assertNotNull("El oráculo debe encontrar un cruce para $target al umbral $threshold en '$description'", oracle)
+        val oracleHours = oracle!!
+
+        val proj = AugeProjection.timeToThreshold(inputs, target, threshold)
+        assertTrue("AugeProjection debe alcanzar el umbral en '$description', fue $proj", proj is ProjectionResult.Reached)
+        val projHours = (proj as ProjectionResult.Reached).hours
+
+        val err = abs(projHours - oracleHours)
+        assertTrue(
+            "Error $err > 0.5 h en '$description' para $target umbral $threshold (proj=$projHours, oracle=$oracleHours)",
+            err <= 0.5,
+        )
+
+        recordedResults.add(
+            OracleResult(target, threshold, oracleHours, projHours, err, description)
+        )
+    }
+
