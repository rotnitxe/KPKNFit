+package com.example.kpkn.domain.auge
+
+import com.example.kpkn.data.models.*
+import java.time.LocalDate
+import java.time.OffsetDateTime
+import java.time.ZonedDateTime
+import kotlin.math.roundToLong
+
+/**
+ * AugeProjection — Tiempo real hasta un umbral de recuperación sobre el mismo motor (WP 2.4, F-22 / R-05).
+ *
+ * Evalúa hacia adelante instantes futuros mediante [AugeSnapshotComputer.compute] con entradas congeladas en t0.
+ * Barrido ordenado con paso de 0,25 h (15 min) hasta un horizonte de 336 h (14 d) y bisección final con ancho
+ * de intervalo <= 0,125 h (7,5 min).
+ */
+object AugeProjection {
+    /** Horizonte de simulación: 14 días (336 horas). */
+    const val HORIZON_HOURS: Double = 336.0
+
+    /** Paso del barrido cronológico ordenado: 15 minutos (0,25 horas). */
+    const val SWEEP_STEP_HOURS: Double = 0.25
+
+    /** Tolerancia máxima del ancho de bisección: 7,5 minutos (0,125 horas). */
+    const val BISECTION_TOLERANCE_HOURS: Double = 0.125
+
+    /** Umbral de compatibilidad histórica para los campos heredados (90 %). */
+    const val COMPATIBILITY_THRESHOLD: Int = 90
+
+    /** Umbral objetivo para la banda «Normal» de recuperación (70 %). */
+    val NORMAL_THRESHOLD: Int = RecoveryBands.NORMAL_MIN
+
+    /**
+     * Calcula el tiempo real (Double, horas) desde [inputs.nowMs] hasta que [target] cruce [threshold].
+     */
+    fun timeToThreshold(
+        inputs: AugeSnapshotInputs,
+        target: ProjectionTarget,
+        threshold: Int = COMPATIBILITY_THRESHOLD,
+    ): ProjectionResult {
+        val evaluator = AugeProjectionEvaluator(inputs)
+        return evaluator.projectTarget(target, threshold)
+    }
+
+    /**
+     * Proyecta múltiples solicitudes compartiendo el caché de evaluaciones temporales.
+     */
+    fun projectMultiple(
+        inputs: AugeSnapshotInputs,
+        requests: List<Pair<ProjectionTarget, Int>>,
+    ): Map<Pair<ProjectionTarget, Int>, ProjectionResult> {
+        val evaluator = AugeProjectionEvaluator(inputs)
+        return requests.associateWith { (target, threshold) ->
+            evaluator.projectTarget(target, threshold)
+        }
+    }
+
+    /**
+     * Proyecta las horas hasta el estado Normal (umbral 70) para los tres canales mostrados de Home.
+     * Devuelve horas enteras redondeadas, o null si el canal no es estimable o no cruza dentro del horizonte.
+     */
+    fun projectHoursToNormal(
+        inputs: AugeSnapshotInputs,
+    ): Map<RecoveryChannelId, Int?> {
+        val evaluator = AugeProjectionEvaluator(inputs)
+        return RecoveryChannelId.entries.associateWith { channel ->
+            evaluator.projectTarget(ProjectionTarget.Channel(channel), NORMAL_THRESHOLD).roundedHoursOrNull
+        }
+    }
+
+    /**
+     * Enriquece una instantánea base poblando los campos de compatibilidad [MuscleRecoveryStatus.hoursToRecovery]
+     * y [ArticularBatteryState.estimatedHoursToRecovery] proyectados al umbral de compatibilidad 90 %.
+     */
+    fun enrichSnapshotCore(
+        core: AugeSnapshotCore,
+        inputs: AugeSnapshotInputs,
+    ): AugeSnapshotCore {
+        return AugeProjectionEvaluator(inputs, initialCore = core).enrichSnapshotCore(core)
+    }
+
+    fun enrichMuscleStatuses(
+        muscles: Map<String, MuscleRecoveryStatus>,
+        inputs: AugeSnapshotInputs,
+        threshold: Int = COMPATIBILITY_THRESHOLD,
+    ): Map<String, MuscleRecoveryStatus> {
+        val evaluator = AugeProjectionEvaluator(inputs)
+        return muscles.mapValues { (name, status) ->
+            val res = evaluator.projectTarget(ProjectionTarget.Muscle(name), threshold)
+            status.copy(hoursToRecovery = res.roundedHoursOrNull)
+        }
+    }
+
+    fun enrichArticularStates(
+        articular: Map<ArticularBattery, ArticularBatteryState>,
+        inputs: AugeSnapshotInputs,
+        threshold: Int = COMPATIBILITY_THRESHOLD,
+    ): Map<ArticularBattery, ArticularBatteryState> {
+        val evaluator = AugeProjectionEvaluator(inputs)
+        return articular.mapValues { (battery, state) ->
+            val res = evaluator.projectTarget(ProjectionTarget.Articular(battery), threshold)
+            state.copy(estimatedHoursToRecovery = res.roundedHoursOrNull)
+        }
+    }
+}
+
+/**
+ * Evaluador de proyección con congelación causal en t0 y memoización por instante.
+ */
+class AugeProjectionEvaluator(
+    private val originalInputs: AugeSnapshotInputs,
+    initialCore: AugeSnapshotCore? = null,
+) {
+    private val t0: Long = originalInputs.nowMs
+
+    /**
+     * Congela la historia y los eventos que existían en t0:
+     * un log o feedback fechado después de t0 no empieza a contar al avanzar la simulación.
+     */
+    val frozenInputs: AugeSnapshotInputs = originalInputs.copy(
+        history = originalInputs.history.filter { val at = AugeUtils.logDateMs(it); at > 0L && at <= t0 },
+        feedbacks = originalInputs.feedbacks.filter { fb ->
+            val ms = runCatching { OffsetDateTime.parse(fb.date).toInstant().toEpochMilli() }
+                .recoverCatching { ZonedDateTime.parse(fb.date).toInstant().toEpochMilli() }
+                .recoverCatching { LocalDate.parse(fb.date.take(10)).atStartOfDay(originalInputs.zone).toInstant().toEpochMilli() }
+                .getOrNull()
+            ms == null || ms <= t0
+        },
+        sleepLogs = originalInputs.sleepLogs.filter { sl ->
+            val ms = runCatching { LocalDate.parse(sl.date.take(10)).atStartOfDay(originalInputs.zone).toInstant().toEpochMilli() }
+                .getOrNull()
+            ms == null || ms <= t0
+        },
+        nutritionLogs = originalInputs.nutritionLogs.filter { nl ->
+            val ms = runCatching { LocalDate.parse(nl.date.take(10)).atStartOfDay(originalInputs.zone).toInstant().toEpochMilli() }
+                .getOrNull()
+            ms == null || ms <= t0
+        },
+    )
+
+    private val evaluationCache: MutableMap<Long, AugeSnapshotCore> = mutableMapOf()
+
+    fun enrichSnapshotCore(core: AugeSnapshotCore): AugeSnapshotCore = core.copy(
+        perMuscle = core.perMuscle.mapValues { (name, status) -> status.copy(hoursToRecovery =
+            projectTarget(ProjectionTarget.Muscle(name), AugeProjection.COMPATIBILITY_THRESHOLD).roundedHoursOrNull) },
+        articular = core.articular.mapValues { (joint, state) -> state.copy(estimatedHoursToRecovery =
+            projectTarget(ProjectionTarget.Articular(joint), AugeProjection.COMPATIBILITY_THRESHOLD).roundedHoursOrNull) },
+    )
+
+    fun hoursToNormal(): Map<RecoveryChannelId, Int?> = RecoveryChannelId.entries.associateWith {
+        projectTarget(ProjectionTarget.Channel(it), RecoveryBands.NORMAL_MIN).roundedHoursOrNull
+    }
+
+    /** Cortes conocidos del motor, mas los instantes anterior/posterior de cada discontinuidad. */
+    private val sweepTimes: List<Double> by lazy {
+        val times = sortedSetOf(0.0, AugeProjection.HORIZON_HOURS)
+        for (step in 1..(AugeProjection.HORIZON_HOURS / AugeProjection.SWEEP_STEP_HOURS).toInt())
+            times += step * AugeProjection.SWEEP_STEP_HOURS
+        fun event(at: Long) {
+            for (offset in listOf(-1L, 0L, 1L)) {
+                val h = (at + offset - t0) / 3_600_000.0
+                if (h > 0.0 && h <= AugeProjection.HORIZON_HOURS) times += h
+            }
+        }
+        frozenInputs.history.forEach { log ->
+            val at = AugeUtils.logDateMs(log)
+            for (h in listOf(8L, 12L, 18L, 24L, 48L, 72L, 168L, 336L, 672L, 720L)) event(at + h * 3_600_000L)
+        }
+        frozenInputs.settings.initialRecoveryEvidence?.let { event(it.expiresAtMs) }
+        val firstDay = java.time.Instant.ofEpochMilli(t0).atZone(frozenInputs.zone).toLocalDate()
+        for (day in 1L..15L) event(firstDay.plusDays(day).atStartOfDay(frozenInputs.zone).toInstant().toEpochMilli())
+        times.toList()
+    }
+
+    init {
+        if (initialCore != null) {
+            evaluationCache[t0] = initialCore
+        }
+    }
+
+    /**
+     * Evalúa el motor en el desplazamiento [deltaHours] desde t0.
+     */
+    fun evaluate(deltaHours: Double): AugeSnapshotCore {
+        val deltaMs = (deltaHours * 3_600_000.0).roundToLong()
+        val targetMs = t0 + deltaMs
+        return evaluationCache.getOrPut(targetMs) {
+            AugeSnapshotComputer.compute(frozenInputs.copy(nowMs = targetMs))
+        }
+    }
+
+    /**
+     * Extrae el score mostrado correspondiente a [target] en [core].
+     */
+    fun scoreFor(core: AugeSnapshotCore, target: ProjectionTarget): Int? = when (target) {
+        is ProjectionTarget.Channel -> when (target.channelId) {
+            RecoveryChannelId.MUSCULAR -> core.dashboard.channelScore(RecoveryChannelId.MUSCULAR, core.batteries.muscular)
+            RecoveryChannelId.SYSTEM -> core.dashboard.channelScore(RecoveryChannelId.SYSTEM, core.batteries.cnc)
+            RecoveryChannelId.STRUCTURE -> core.dashboard.channelScore(RecoveryChannelId.STRUCTURE, core.batteries.spinal)
+        }
+        is ProjectionTarget.Muscle -> lookupMuscleValue(core.perMuscle, target.muscleName)?.recoveryScore
+        is ProjectionTarget.Articular -> core.articular[target.articularBattery]?.recoveryScore
+    }
+
+    /**
+     * Comprueba la cobertura o existencia de datos para [target] en t0.
+     */
+    private fun checkDataAvailability(core0: AugeSnapshotCore, target: ProjectionTarget): ProjectionResult.NotEstimable? {
+        when (target) {
+            is ProjectionTarget.Channel -> {
+                val coverage = core0.coverage.channel(target.channelId)
+                if (!coverage.hasData) {
+                    return ProjectionResult.NotEstimable.NoData
+                }
+            }
+            is ProjectionTarget.Muscle -> {
+                val status = lookupMuscleValue(core0.perMuscle, target.muscleName)
+                    ?: return ProjectionResult.NotEstimable.UnknownTarget
+                val hasSession = status.hoursSinceLastSession >= 0
+                val hasManualAnchor = frozenInputs.wellbeing?.let { wellbeing ->
+                    lookupMuscleValue(wellbeing.manualMuscleOverridesV2, target.muscleName) != null ||
+                        lookupMuscleValue(wellbeing.manualMuscleBatteries, target.muscleName) != null
+                } == true
+                val hasInitialEvidence = frozenInputs.settings.initialRecoveryEvidence?.let { ev ->
+                    InitialRecoveryEvidencePolicy.resolve(
+                        InitialRecoveryPolicyInput(ev, t0, frozenInputs.history, frozenInputs.zone)
+                    ).muscular != null
+                } ?: false
+                if (!hasSession && !hasManualAnchor && !hasInitialEvidence) {
+                    return ProjectionResult.NotEstimable.NoData
+                }
+            }
+            is ProjectionTarget.Articular -> {
+                val state = core0.articular[target.articularBattery]
+                    ?: return ProjectionResult.NotEstimable.UnknownTarget
+                val hasSession = frozenInputs.history.isNotEmpty()
+                val hasStress = state.accumulatedStress > 0.0
+                if (!hasSession && !hasStress) {
+                    return ProjectionResult.NotEstimable.NoData
+                }
+            }
+        }
+        return null
+    }
+
+    /**
+     * Proyecta el tiempo hasta [threshold] para [target].
+     */
+    fun projectTarget(target: ProjectionTarget, threshold: Int): ProjectionResult {
+        require(threshold in 0..100) { "Umbral fuera de 0..100" }
+        val core0 = evaluate(0.0)
+        val notEstimable = checkDataAvailability(core0, target)
+        if (notEstimable != null) return notEstimable
+
+        val score0 = scoreFor(core0, target) ?: return ProjectionResult.NotEstimable.UnknownTarget
+        if (score0 >= threshold) {
+            return ProjectionResult.Reached(0.0)
+        }
+
+        // Barrido cronológico ordenado con paso SWEEP_STEP_HOURS
+        var tPrev = 0.0
+        var tCurrent = AugeProjection.SWEEP_STEP_HOURS
+        var crossed = false
+
+        for (candidate in sweepTimes.drop(1)) {
+            tCurrent = candidate
+            val core = evaluate(tCurrent)
+            val s = scoreFor(core, target) ?: return ProjectionResult.NotEstimable.UnknownTarget
+            if (s >= threshold) {
+                crossed = true
+                break
+            }
+            tPrev = tCurrent
+        }
+
+        if (!crossed) {
+            // Comprobar si hay un bloqueo persistente (ej. DOMS/molestia insuperable)
+            val isBlocked = when (target) {
+                is ProjectionTarget.Muscle -> core0.continuous.perMuscle[target.muscleName]?.blocked == true
+                is ProjectionTarget.Channel -> when (target.channelId) {
+                    RecoveryChannelId.STRUCTURE -> core0.continuous.spineShown.blocked
+                    RecoveryChannelId.MUSCULAR -> core0.continuous.musclesGlobal.blocked
+                    RecoveryChannelId.SYSTEM -> false
+                }
+                is ProjectionTarget.Articular -> false
+            }
+            return if (isBlocked) {
+                ProjectionResult.NotEstimable.Blocked
+            } else {
+                ProjectionResult.NotEstimable.NoCrossingWithinHorizon
+            }
+        }
+
+        // Bisección en [tPrev, tCurrent] hasta ancho <= BISECTION_TOLERANCE_HOURS
+        var a = tPrev
+        var b = tCurrent
+        while ((b - a) > AugeProjection.BISECTION_TOLERANCE_HOURS + 1e-9) {
+            val mid = (a + b) / 2.0
+            val midCore = evaluate(mid)
+            val midScore = scoreFor(midCore, target) ?: return ProjectionResult.NotEstimable.UnknownTarget
+            if (midScore >= threshold) {
+                b = mid
+            } else {
+                a = mid
+            }
+        }
+
+        // La respuesta es el extremo superior del intervalo que satisface el predicado (b).
+        return ProjectionResult.Reached(b)
+    }
+}
