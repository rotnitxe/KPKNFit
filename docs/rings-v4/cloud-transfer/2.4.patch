+// ─── AugeProjection Types ──────────────────────────────────────────────────
+
+sealed class ProjectionTarget {
+    data class Channel(val channelId: RecoveryChannelId) : ProjectionTarget()
+    data class Muscle(val muscleName: String) : ProjectionTarget()
+    data class Articular(val articularBattery: ArticularBattery) : ProjectionTarget()
+}
+
+sealed class ProjectionResult {
+    data class Reached(val hours: Double) : ProjectionResult() {
+        fun toRoundedHours(): Int = kotlin.math.round(hours).toInt()
+    }
+
+    sealed class NotEstimable(val reason: String) : ProjectionResult() {
+        object NoData : NotEstimable("Sin datos o cobertura suficiente")
+        object UnknownTarget : NotEstimable("Objetivo no encontrado en el modelo")
+        object Blocked : NotEstimable("Bloqueo persistente que impide alcanzar el umbral")
+        object NoCrossingWithinHorizon : NotEstimable("El score no cruza el umbral en el horizonte de 336 h")
+    }
+
+    val hoursOrNull: Double?
+        get() = when (this) {
+            is Reached -> hours
+            is NotEstimable -> null
+        }
+
+    val roundedHoursOrNull: Int?
+        get() = when (this) {
+            is Reached -> toRoundedHours()
+            is NotEstimable -> null
+        }
+}
