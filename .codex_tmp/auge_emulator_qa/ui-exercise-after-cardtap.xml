 ejecutan como su hermana plana pero con el torso elevado, dejando que las mancuernas abran el arco hasta sentir el tirón y cerrando con control. La máquina de aperturas sostiene la trayectoria cuando la fatiga empieza a mandar. Detalle fino para un pecho completo visto de frente." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,2170][1001,2363]" drawing-order="2" hint="" /></node></node><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[89,2106][991,2253]" drawing-order="2" hint=""><node index="0" text="" resource-id="" class="android.widget.EditText" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="true" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[89,2106][991,2253]" drawing-order="0" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[226,2158][949,2201]" drawing-order="0" hint="" /><node index="1" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[226,2117][840,2243]" drawing-order="1" hint=""><node index=