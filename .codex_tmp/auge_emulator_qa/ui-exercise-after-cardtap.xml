able="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,373][1038,892]" drawing-order="1" hint=""><node index="0" text="Glúteo Medio" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,410][253,444]" drawing-order="0" hint="" /><node index="1" text="Abducciones de Pierna" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,465][1001,514]" drawing-order="1" hint="" /><node index="2" text="Las Abducciones de Pierna trabajan el costado de la cadera que nadie ve pero todos necesitan: el glúteo medio separa la pierna del centro contra resistencia y estabiliza la pelvis en cada paso que das. Se hacen en la máquina de abducción, sentado, abriendo las piernas con pausa y regresando sin que las almohadillas golpeen. Con banda o polea la misma idea cabe en casa o de pie. El escudo invisible de rodillas y cadera, y el pincel que redondea el lateral del glúteo." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,535][1001,778]" drawing-order="2" hint="" /><node index="3" text="" resource-id="" class="android.widget.HorizontalScrollView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="fal