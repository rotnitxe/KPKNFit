[745,1364]" drawing-order="2" hint=""><node index="0" text="En Máquina" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[567,1284][721,1318]" drawing-order="0" hint="" /></node></node></node><node index="3" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1392][1038,1911]" drawing-order="3" hint=""><node index="0" text="Deltoides" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1429][201,1463]" drawing-order="0" hint="" /><node index="1" text="Aperturas Inversas" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1484][1001,1533]" drawing-order="1" hint="" /><node index="2" text="Las Aperturas Inversas son el espejo del trabajo de pecho: los brazos se abren hacia atrás y el deltoides posterior, con romboides y trapecio medio, escribe la otra mitad del hombro. Se practican en la máquina de aperturas invertida, separando los brazos con control sin dejar que las escápulas se adelanten. Con polea cruzada el trabajo puede hacerse a un brazo, ideal para pulir lados desiguales. El seguro de postura y equilibrio de hombros que todo programa necesita." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1554][1001,1797]" drawing-order="2" hint="" /><node index="3" text="" resource-id="" class="android.widget.HorizontalScrollView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1818][1001,1874]" drawing-order="3" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1783][410,1909]" drawing-order="0" hint=""><node index="0" text="En Máquina Pec Deck" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[103,1829][386,1863]" drawing-order="0" hint="" /></node><node index="1" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[426,1783][589,1909]" drawing-order="1" hint=""><node index="0" text="En Polea" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" select