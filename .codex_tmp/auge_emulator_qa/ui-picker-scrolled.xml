anco y el pectoral se alarga bajo carga como en ningún press. Se ejecutan con mancuernas y los codos ligeramente flexionados, bajando en un abrazo amplio hasta la línea del pecho y cerrando sin chocarlas arriba. En polea la tensión sobrevive al punto alto, justo donde las mancuernas perdonan. El modelador del pecho por excelencia y su mejor estiramiento cargado." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,2099][1001,2342]" drawing-order="2" hint="" /></node></node><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[89,2106][991,2253]" drawing-order="2" hint=""><node index="0" text="" resource-id="" class="android.widget.EditText" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="true" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[89,2106][991,2253]" drawing-order="0" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[226,2158][949,2201]" drawing-order="0" hint="" /><node index="1" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" se