sed="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,318][1038,837]" drawing-order="1" hint=""><node index="0" text="Pectorales" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,355][218,389]" drawing-order="0" hint="" /><node index="1" text="Aperturas Declinadas" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,410][943,459]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="Seleccionado" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[959,414][1001,456]" drawing-order="2" hint="" /><node index="3" text="Las Aperturas Declinadas ponen el torso cabeza abajo para apuntar al borde inferior del pectoral: el arco se abre desde un ángulo que rara vez se entrena aislado. Se ejecutan en banco declinado con las piernas aseguradas, abriendo las mancuernas con los codos suaves y cerrando sobre el pecho bajo. El acabado inferior del pectoral tiene aquí su herramienta específica." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,480][1001,723]" drawing-order="3" hint="" /><node index="4" text="" resource-id="" class="android.widget.Horiz