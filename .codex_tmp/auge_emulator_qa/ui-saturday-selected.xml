cked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,2045][1001,2094]" drawing-order="1" hint="" /><node index="2" text="Las Aperturas Planas son el estiramiento del pectoral convertido en ejercicio: los brazos se abren en arco sobre el banco y el pectoral se alarga bajo carga como en ningún press. Se ejecutan con mancuernas y los codos ligeramente flexionados, bajando en un abrazo amplio hasta la línea del pecho y cerrando sin chocarlas arriba. En polea la tensión sobrevive al punto alto, justo donde las mancuernas perdonan. El modelador del pecho por excelencia y su mejor estiramiento cargado." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,2115][1001,2358]" drawing-order="2" hint="" /></node></node><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[89,1954][991,2101]" drawing-order="2" hint=""><node index="0" text="" resource-id="" class="android.widget.EditText" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[89,1954][991,2101]" drawing-order="0" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password