{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orquestador",
  "permission": {
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "*.keystore": "deny",
      "**/*.keystore": "deny",
      ".cursor/mcp.json": "deny",
    },
    "edit": {
      "*.env": "deny",
      "*.env.*": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "*.keystore": "deny",
      "**/*.keystore": "deny",
      ".cursor/mcp.json": "deny",
      ".opencode/pipeline.json": "deny",
    },
    "memory": "allow",
    "kpkn_map": "allow",
    "session_search": "allow",
    "skill_manage": "allow",
    "pipeline": "allow",
    "mode_config": "allow",
  },
}
