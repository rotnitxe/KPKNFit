# KPKN Fit - Environment Variables
# Copy this file to .env and fill in your values

# AI Providers (user-provided keys stored in app settings)
# These are optional - users can provide their own keys in the app

# Sentry Error Tracking (optional - recommended for production)
VITE_SENTRY_DSN=

# Supabase (optional - for cloud sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Drive Integration (optional)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Builder.io (optional)
VITE_BUILDER_KEY=

# Figma (optional)
VITE_FIGMA_TOKEN=