<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.KPKN" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/kpkn_window_background</item>
        <item name="android:colorBackground">@color/kpkn_window_background</item>
    </style>

    <!-- Tema de arranque de MainActivity (SplashScreen API): fondo tinta de marca y la Torre anidada en crema.
         installSplashScreen() cambia la Activity a Theme.KPKN (postSplashScreenTheme) cuando termina el splash. -->
    <style name="Theme.KPKN.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kpkn_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_kpkn</item>
        <item name="postSplashScreenTheme">@style/Theme.KPKN</item>
    </style>
</resources>
