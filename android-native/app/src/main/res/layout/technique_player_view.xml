<?xml version="1.0" encoding="utf-8"?>
<!--
  Vista del reproductor de la pantalla «Análisis de técnica» (TechniqueVideoPlayer). La superficie es un TextureView y no la
  SurfaceView por defecto: un TextureView recibe el recorte redondeado, la opacidad y las transformaciones de Compose; una
  SurfaceView se dibuja aparte y las ignora. Sin controles (los mandos son de Compose) y en FIT, que también se fijan en código.
  Es propia y no la de la bienvenida (welcome_video_player): así un cambio en una no rompe a la otra.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:resize_mode="fit"
    app:surface_type="texture_view"
    app:use_controller="false" />
