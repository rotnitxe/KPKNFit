ecked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[127,231][262,242]" drawing-order="0" hint="" /><node index="1" text="" resource-id="" class="android.widget.Button" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,231][294,276]" drawing-order="1" hint="" /></node></node><node index="1" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,344][1027,813]" drawing-order="1" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,344][1027,512]" drawing-order="0" hint=""><node index="0" text="INTENSIDAD Y ESFUERZO" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,381][434,415]" drawing-order="0" hint="" /><node index="1" text="RIR (Repeticiones en Reserva)" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,426][670,475]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="Expandir RIR (Repeticiones en Reserva)" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[922,397][985,460]" drawing-order="2" hint="" /></node><node index="1" text="RIR significa repeticiones en reserva: una estimación de cuántas repeticiones técnicamente válidas podrías haber completado al terminar una serie. RIR 0 representa el fallo concéntrico de esa tarea; RIR 2 indica que probablemente quedaban dos repeticiones. Es una predicción, no una medición directa, y su precisión cambia con el ejercicio, la experiencia, la velocidad y el estado de fatiga.&#10;&#10;Usar RIR ayuda a autorregular la carga sin depender de un porcentaje fijo que puede quedar desfasado. Permite mantener un esfuerzo exigente mientras se conserva margen para la técnica, y hace visible cuándo una sesión está saliendo más fácil o más difícil de lo esperado. No conviene tratarlo como una verdad exacta ni compararlo entre ejercicios muy distintos. La interpretación mejora si registras repeticiones, carga, velocidad y sensación, y si ocasionalmente contrastas la estimación con series cercanas al límite de forma segura.&#10;&#10;La estimación suele ser más consistente en ejercicios conocidos y con repeticiones estables. En movimientos complejos, la técnica puede fallar antes que el músculo objetivo, por lo que el RIR debe describir la repetición que aún sería válida, no una repetición forzada con compensaciones." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,512][985,650]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,656][294,782]" drawing-order="2" hint=""><node index="0" text="Leer más" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[127,700][262,737]" drawing-order="0" hint="" /><node index="1" text="" resource-id="" class="android.widget.Button" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,666][294,771]" drawing-order="1" hint="" /></node></node><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,839][1027,1308]" drawing-order="2" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,839][1027,1007]" drawing-order="0" hint=""><node index="0" text="INTENSIDAD Y ESFUERZO" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,876][434,910]" drawing-order="0" hint="" /><node index="1" text="RPE (Percepción del Esfuerzo)" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,921][674,970]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="Expandir RPE (Percepción del Esfuerzo)" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[922,892][985,955]" drawing-order="2" hint="" /></node><node index="1" text="RPE es una escala subjetiva que resume cuánto esfuerzo percibiste en una serie, sesión o tarea. En fuerza suele usarse una escala de 1 a 10, donde los valores altos indican que queda poco margen; en ese contexto puede relacionarse con RIR, pero no son sinónimos perfectos. RPE integra señales como respiración, tensión, velocidad, concentración y sensación de dificultad.&#10;&#10;Su valor está en capturar la realidad del día. La misma carga puede sentirse distinta por sueño insuficiente, estrés, dolor o acumulación de trabajo, y una escala fija no conoce esas variaciones. Aun así, el RPE es vulnerable a expectativas y experiencia: una persona puede sobreestimarlo o subestimarlo, especialmente lejos del fallo. Úsalo para complementar datos objetivos, no para reemplazarlos. Registrar el RPE junto con carga, repeticiones y técnica permite decidir si conviene mantener, reducir o aumentar el estímulo.&#10;&#10;Usar la escala resulta más fácil cuando anotas qué significó cada número para ti. Un RPE 8 en una sentadilla y en un curl no tiene la misma carga respiratoria ni la misma precisión, pero ambos pueden informar si la sesión está dentro del plan. La conversación entre sensación y registro es la herramienta." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1007][985,1145]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1151][294,1277]" drawing-order="2" hint=""><node index="0" text="Leer más" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[127,1195][262,1232]" drawing-order="0" hint="" /><node index="1" text="" resource-id="" class="android.widget.Button" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1161][294,1266]" drawing-order="1" hint="" /></node></node><node index="3" text="FATIGA Y RECUPERACIÓN" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[64,1347][436,1381]" drawing-order="3" hint="" /><node index="4" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1397][1027,1866]" drawing-order="4" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1397][1027,1565]" drawing-order="0" hint=""><node index="0" text="FATIGA Y RECUPERACIÓN" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1434][436,1468]" drawing-order="0" hint="" /><node index="1" text="Daño Muscular" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1479][379,1528]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="Expandir Daño Muscular" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[922,1450][985,1513]" drawing-order="2" hint="" /></node><node index="1" text="El daño muscular describe alteraciones estructurales y funcionales que pueden aparecer después de un esfuerzo no habitual o muy exigente. Se manifiesta junto con dolor muscular de aparición tardía, pérdida temporal de fuerza, inflamación y cambios en la sensibilidad; ninguna de esas señales, por sí sola, mide con precisión cuánto tejido se ha dañado. El cuerpo repara y remodela esas estructuras como parte de la respuesta al entrenamiento.&#10;&#10;Sentir más agujetas no significa haber creado más crecimiento. El daño puede acompañar una sesión efectiva, pero también interferir con el rendimiento posterior y alargar la recuperación. La adaptación repetida suele reducir la respuesta dañina a un mismo estímulo, mientras que ejercicios nuevos, grandes estiramientos bajo carga o aumentos bruscos la elevan. Conviene progresar gradualmente, observar la función y no usar el dolor como objetivo. Si el dolor es intenso, focal o persiste, deja de ser una simple señal de entrenamiento y merece evaluación.&#10;&#10;El daño no es el objetivo que se debe perseguir para demostrar que una sesión funcionó. Un estímulo novedoso puede causar más molestias aunque el crecimiento no sea mayor, y repetirlo sin adaptación puede limitar el entrenamiento posterior. La progresión gradual permite aprender qué dosis toleras sin convertir el dolor en métrica." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1565][985,1703]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1709][294,1835]" drawing-order="2" hint=""><node index="0" text="Leer más" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[127,1753][262,1790]" drawing-order="0" hint="" /><node index="1" text="" resource-id="" class="android.widget.Button" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1719][294,1824]" drawing-order="1" hint="" /></node></node><node index="5" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1892][1027,2337]" drawing-order="5" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1892][1027,2060]" drawing-order="0" hint=""><node index="0" text="FATIGA Y RECUPERACIÓN" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1929][436,1963]" drawing-order="0" hint="" /><node index="1" text="Fatiga Sistémica" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1974][408,2023]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="Contraer Fatiga Sistémica" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[922,1945][985,2008]" drawing-order="2" hint="" /></node><node index="1" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,2060][1027,2400]" drawing-order="1" hint=""><node index="0" text="La fatiga sistémica es la reducción temporal de la capacidad de rendir que afecta a varios sistemas del organismo, no solo al músculo que trabajaste. Puede incluir menor activación neural, cambios en la coordinación, sensación de agotamiento, alteraciones del sueño o una menor disposición para entrenar. No es una sustancia única ni puede deducirse con certeza a partir de un solo síntoma.&#10;&#10;Se acumula cuando la demanda del entrenamiento y de la vida supera repetidamente la recuperación disponible. Sesiones muy voluminosas, cargas altas, poco sueño, estrés y déficit energético pueden interactuar, pero la relación no es lineal. La señal práctica es un patrón persistente: rendimiento que cae, técnica que se deteriora y esfuerzo que aumenta con cargas habituales. Reducir temporalmente la demanda, mejorar el descanso y revisar la distribución semanal suele ser más útil que perseguir una cifra abstracta de fatiga.&#10;&#10;No todo cansancio exige una descarga y no toda fatiga se siente como sueño. Compara varios indicadores con tu línea habitual: rendimiento, coordinación, ganas de entrenar y recuperación entre sesiones. Una decisión prudente reduce la demanda durante unos días y observa si la capacidad vuelve, en lugar de etiquetar una causa con certeza." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false"