ble="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[180,302][979,342]" drawing-order="0" hint="" /><node index="1" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[180,263][979,389]" drawing-order="1" hint="" /></node></node><node index="1" text="GESTIÓN DE CARGA" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[64,427][353,461]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,477][1027,946]" drawing-order="2" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,477][1027,645]" drawing-order="0" hint=""><node index="0" text="GESTIÓN DE CARGA" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,514][361,548]" drawing-order="0" hint="" /><node index="1" text="Frecuencia de Entrenamiento" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,559][648,608]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="Expandir Frecuencia de Entrenamiento" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[922,530][985,593]" drawing-order="2" hint="" /></node><node index="1" text="La frecuencia es cuántas veces entrenas una cualidad, un movimiento o un grupo muscular dentro de un periodo, normalmente una semana. No es solo el número de visitas al gimnasio: una sesión cuenta para un músculo cuando recibe un estímulo relevante. Distribuir el trabajo en más días puede cambiar la calidad de las series, la práctica técnica y la fatiga de cada sesión.&#10;&#10;La frecuencia no tiene un valor mágico separado del volumen total. Cuando el volumen semanal se iguala, distintas distribuciones pueden producir resultados parecidos, así que la mejor opción depende del tiempo disponible, la recuperación y la tolerancia a sesiones largas. Aumentarla puede ayudar a repartir muchas series, practicar una habilidad con más regularidad o evitar que el rendimiento caiga al final de una sesión. Reducirla puede ser razonable cuando el descanso, el trabajo o la vida cotidiana limitan la recuperación.&#10;&#10;Una distribución práctica debe dejar espacio para que cada sesión conserve repeticiones de calidad. Si dividir el trabajo reduce la fatiga de una sola jornada, puede ser una mejora aunque el total semanal no cambie. Si multiplicar días solo añade desplazamientos y series mediocres, no aporta una ventaja automática." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,645][985,783]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,789][294,915]" drawing-order="2" hint=""><node index="0" text="Leer más" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[127,833][262,870]" drawing-order="0" hint="" /><node index="1" text="" resource-id="" class="android.widget.Button" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,799][294,904]" drawing-order="1" hint="" /></node></node><node index="3" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,972][1027,1441]" drawing-order="3" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,972][1027,1140]" drawing-order="0" hint=""><node index="0" text="GESTIÓN DE CARGA" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1009][361,1043]" drawing-order="0" hint="" /><node index="1" text="Intensidad" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1054][295,1103]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="Expandir Intensidad" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[922,1025][985,1088]" drawing-order="2" hint="" /></node><node index="1" text="En entrenamiento de fuerza, intensidad describe lo demandante que es una carga respecto de tu capacidad actual. A menudo se expresa como porcentaje de una repetición máxima, pero también puede referirse a la dificultad relativa de una serie, a la velocidad de ejecución o a la proximidad del fallo. Por eso una misma cifra de kilos no representa la misma intensidad para dos personas ni para el mismo atleta en días distintos.&#10;&#10;La intensidad orienta qué adaptaciones se practican. Cargas altas exigen producir mucha fuerza y suelen ser específicas para mejorar levantamientos pesados; cargas moderadas o ligeras también pueden estimular hipertrofia si se acercan lo suficiente al límite, aunque con distinta sensación y coste técnico. No debe confundirse intensidad con volumen ni con esfuerzo percibido. Interpretarla junto con repeticiones, RIR, técnica y velocidad permite elegir una carga desafiante, pero suficientemente estable para repetir el estímulo.&#10;&#10;También conviene preguntar siempre: ¿intensidad de qué? Una carga puede ser alta respecto de tu máximo, pero una serie puede sentirse moderada si quedan muchas repeticiones. Nombrar la referencia evita discusiones y ayuda a elegir el estímulo sin confundir dificultad local con esfuerzo global." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1140][985,1278]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1284][294,1410]" drawing-order="2" hint=""><node index="0" text="Leer más" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[127,1328][262,1365]" drawing-order="0" hint="" /><node index="1" text="" resource-id="" class="android.widget.Button" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1294][294,1399]" drawing-order="1" hint="" /></node></node><node index="4" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1467][1027,1936]" drawing-order="4" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1467][1027,1635]" drawing-order="0" hint=""><node index="0" text="GESTIÓN DE CARGA" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1504][361,1538]" drawing-order="0" hint="" /><node index="1" text="Volumen de Entrenamiento" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1549][608,1598]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="Expandir Volumen de Entrenamiento" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[922,1520][985,1583]" drawing-order="2" hint="" /></node><node index="1" text="El volumen es la cantidad acumulada de trabajo que realizas. Puede describirse con series, repeticiones, carga externa, tiempo bajo tensión o una combinación de esas medidas. No existe una única fórmula válida para todos los objetivos: contar toneladas puede ser útil en algunos levantamientos, mientras que las series exigentes por grupo muscular suelen ser más interpretables para hipertrofia.&#10;&#10;El volumen importa porque determina buena parte del estímulo y también de la recuperación necesaria. Más trabajo no equivale automáticamente a más adaptación; llega un punto en que las series adicionales aportan poco y consumen recursos que podrían mejorar la técnica o el rendimiento. Conviene observar la tendencia de varias semanas, distinguir series realmente estimulantes de calentamientos y ajustar según rendimiento, sueño, molestias y evolución. El volumen adecuado es el que puedes repetir con calidad y progresar sin que la fatiga desborde tu capacidad de recuperación.&#10;&#10;En la práctica, cuenta el trabajo que realmente puedes recuperar, no solo el que cabe en la hoja. Una serie cerca del límite puede pesar más que varias muy cómodas, y el mismo número cambia según el ejercicio. Mira tendencias de rendimiento y medidas corporales antes de añadir otra serie." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1635][985,1773]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1779][294,1905]" drawing-order="2" hint=""><node index="0" text="Leer más" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[127,1823][262,1860]" drawing-order="0" hint="" /><node index="1" text="" resource-id="" class="android.widget.