kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1769][1254,1826]" drawing-order="1" hint="" /><node index="2" text="Las Aperturas Inversas son el espejo del trabajo de pecho: los brazos se abren hacia atrás y el deltoides posterior, con romboides y trapecio medio, escribe la otra mitad del hombro. Se practican en la máquina de aperturas invertida, separando los brazos con control sin dejar que las escápulas se adelanten. Con polea cruzada el trabajo puede hacerse a un brazo, ideal para pulir lados desiguales. El seguro de postura y equilibrio de hombros que todo programa necesita." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1850][1254,2127]" drawing-order="2" hint="" /><node index="3" text="" resource-id="" class="android.widget.HorizontalScrollView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2151][1254,2214]" drawing-order="3" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2111][475,2255]" drawing-order="0" hint=""><node index="0" text="En Máquina Pec Deck" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused=