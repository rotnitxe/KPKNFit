o: los brazos se abren hacia atrás y el deltoides posterior, con romboides y trapecio medio, escribe la otra mitad del hombro. Se practican en la máquina de aperturas invertida, separando los brazos con control sin dejar que las escápulas se adelanten. Con polea cruzada el trabajo puede hacerse a un brazo, ideal para pulir lados desiguales. El seguro de postura y equilibrio de hombros que todo programa necesita." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1257][1254,1534]" drawing-order="2" hint="" /><node index="3" text="" resource-id="" class="android.widget.HorizontalScrollView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1558][1254,1621]" drawing-order="3" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1518][475,1662]" drawing-order="0" hint=""><node index="0" text="En Máquina Pec Deck" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[117,1570][448,1609]" drawing-order="0" hint="" /></node><node index="1" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="t