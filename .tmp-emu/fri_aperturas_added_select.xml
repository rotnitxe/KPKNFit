android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1798][1254,1855]" drawing-order="1" hint="" /><node index="2" text="Las Aperturas Planas son el estiramiento del pectoral convertido en ejercicio: los brazos se abren en arco sobre el banco y el pectoral se alarga bajo carga como en ningún press. Se ejecutan con mancuernas y los codos ligeramente flexionados, bajando en un abrazo amplio hasta la línea del pecho y cerrando sin chocarlas arriba. En polea la tensión sobrevive al punto alto, justo donde las mancuernas perdonan. El modelador del pecho por excelencia y su mejor estiramiento cargado." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1879][1254,2156]" drawing-order="2" hint="" /><node index="3" text="" resource-id="" class="android.widget.HorizontalScrollView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2180][1254,2243]" drawing-order="3" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2140][403,2284]" drawing-order="0" hint=""><node index="0" text="Con Mancuernas" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickabl