le="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2484][1254,2541]" drawing-order="1" hint="" /><node index="2" text="Las Aperturas Inclinadas llevan el abrazo amplio a la parte alta del pecho: en el banco inclinado, el estiramiento bajo carga se concentra en las fibras claviculares del pectoral. Se ejecutan como su hermana plana pero con el torso elevado, dejando que las mancuernas abran el arco hasta sentir el tirón y cerrando con control. La máquina de aperturas sostiene la trayectoria cuando la fatiga empieza a mandar. Detalle fino para un pecho completo visto de frente." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2565][1254,2842]" drawing-order="2" hint="" /><node index="3" text="" resource-id="" class="android.widget.HorizontalScrollView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2866][1254,2929]" drawing-order="3" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2826][403,2970]" drawing-order="0" hint=""><node index="0" text="Con Mancuernas" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[117,2878][376,29