"true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,345][1296,419]" drawing-order="0" hint="" /><node index="1" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,449][1296,1041]" drawing-order="1" hint=""><node index="0" text="Glúteo Medio" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,491][295,530]" drawing-order="0" hint="" /><node index="1" text="Patada de Glúteo Lateral" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,554][1188,611]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="Seleccionado" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1206,559][1254,607]" drawing-order="2" hint="" /><node index="3" text="La Patada de Glúteo Lateral abre la pierna hacia el costado con la cadera quieta: el glúteo medio hace todo el trabajo mientras el torso no se vende al balanceo. Se ejecuta con polea baja enganchada al tobillo, de pie, separando la pierna con pausa y volviendo sin cruzar el centro. Con banda o una mancuerna suave se puede montar en cualquier rincón. La herramienta precisa para el lateral del glúteo y una pelvis que no baila." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,635][1254,912]" drawing-order="3" hint="" /><node index="4" text="" resource-id="" class="android.widget.HorizontalScrollView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,936][1254,999]" drawing-order="4" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,896][278,1040]" drawing-order="0" hint=""><node index="0" text="En Polea" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[117,948][251,987]" drawing-order="0" hint="" /></node><node index="1" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[296,896][609,1040]" drawing-order="1" hint=""><node index="0" text="Con Mancuernas" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[323,948][582,987]" drawing-order="0" hint="" /></node><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[627,896][850,1040]" drawing-order="2" hint=""><node index="0" text="Con Banda" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[654,948][823,987]" drawing-order="0" hint="" /></node></node></node><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,1071][1296,1663]" drawing-order="2" hint=""><node index="0" text="Aductores" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1113][249,1152]" drawing-order="0" hint="" /><node index="1" text="Aducciones de Pierna" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1176][1254,1233]" drawing-order="1" hint="" /><node index="2" text="Las Aducciones de Pierna llevan la pierna hacia el centro contra resistencia y cargan la cara interna del muslo, esa zona que la sentadilla roza pero no termina de tocar. Se ejecutan en la máquina de aducción, cerrando las piernas con control y soltando despacio. La polea baja y la banda ofrecen el mismo trabajo de pie o en casa. Equilibrio muscular real para una cadera a prueba de giros." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1257][1254,1534]" drawing-order="2" hint="" /><node index="3" text="" resource-id="" class="android.widget.HorizontalScrollView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1558][1254,1621]" drawing-order="3" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1518][324,1662]" drawing-order="0" hint=""><node index="0" text="En Máquina" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[117,1570][297,1609]" drawing-order="0" hint="" /></node><node index="1" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[342,1518][530,1662]" drawing-order="1" hint=""><node index="0" text="En Polea" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[369,1570][503,1609]" drawing-order="0" hint="" /></node><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[548,1518][769,1662]" drawing-order="2" hint=""><node index="0" text="Con Banda" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[575,1570][742,1609]" drawing-order="0" hint="" /></node></node></node><node index="3" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[48,1693][1296,2198]" drawing-order="3" hint=""><node index="0" text="Aductores" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1735][249,1774]" drawing-order="0" hint="" /><node index="1" text="Plancha Copenhague" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1798][1254,1855]" drawing-order="1" hint="" /><node index="2" text="La Plancha Copenhague convierte los aductores en el puente del cuerpo: de lado, con la pierna superior apoyada en un banco, la cara interna del muslo sostiene la cadera en el aire. Se ejecuta apoyando el antebrazo y aguantando la línea recta de cabeza a pies el mayor tiempo posible. El core asiste en la estabilidad lateral. La plancha más dura por centímetro cuadrado y la mejor protección de ingle que existe." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1879][1254,2156]" drawing-order="2" hint="" /></node><node index="4" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[48,2228][1296,2733]" drawing-order="4" hint=""><node index="0" text="Aductores" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2270][249,2309]" drawing-order="0" hint="" /><node index="1" text="Plancha Copenhague Dinámica" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2333][1254,2390]" drawing-order="1" hint="" /><node index="2" text="La Plancha Copenhague Dinámica mete movimiento en la postura lateral: con la pierna arriba apoyada, la cadera baja y sube sin tocar el suelo. Los aductores trabajan ahora en acortamiento y estiramiento, no solo en isometría, y la fatiga llega el doble de rápido. Se ejecuta con el antebrazo firme y el ritmo lento. La progresión para quien la versión estática ya respira tranquila." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2414][1254,2691]" drawing-order="2" hint="" /></node><node index="5" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[48,2763][1296,2992]" drawing-order="5" hint=""><node index="0" text="Glúteos" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2805][102,2844]" drawing-order="0" hint="" /><node index="1" text="Patada de Glúteos Diagonal en Polea" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2868][1254,2925]" drawing-order="1" hint="" /><node index="2" text="La Patada de Glúteos Diagonal en Polea cruza la trayectoria: la pierna sale atrás y hacia afuera en un arco diagonal que mezcla extensión y apertura de cadera. Se ejecuta con el tobillo enganchado a la polea baja, dejando que la pierna dibuje la diagonal completa y vuelva sin tocar el suelo. El glúteo mayor recibe tensión en una línea que las patadas rectas no cubren. El toque final para redondear el trabajo de glúteo." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2949][1254,2950]" drawing-order="2" hint="" /></node></node><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[102,2482][1242,2650]" drawing-order="2" hint=""><node index="0" text="Abducciones de Pierna" resource-id="" class="android.widget.EditText" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="true" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[102,2482][1242,2650]" drawing-order="0" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[258,2542][1194,2591]" drawing-order="0" hint="" /></node></node><node index="3" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[102,2728][1242,2878]" d