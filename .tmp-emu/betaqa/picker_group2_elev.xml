g-order="1" hint="" /><node index="2" text="Las Elevaciones Laterales Super ROM alargan el recorrido por debajo del punto de partida: la polea cruza por detrás y el deltoide medio trabaja desde un estiramiento que la versión normal no toca. Se ejecutan con la polea baja cruzada, subiendo en el arco lateral completo hasta la horizontal. El rango extra se traduce en más tiempo bajo tensión por repetición. La evolución del clásico para quien ya exprimió el gesto estándar." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2012][1254,2289]" drawing-order="2" hint="" /><node index="3" text="" resource-id="" class="android.widget.HorizontalScrollView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2313][1254,2376]" drawing-order="3" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2273][278,2417]" drawing-order="0" hint=""><node index="0" text="En Polea" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[117,2325][251,2364]" drawing-order="0" hint="" /></node><node index="1" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="fals