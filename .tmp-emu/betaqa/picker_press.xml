 /><node index="6" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[287,995][431,1119]" drawing-order="6" hint="" /></node><node index="3" text="El Press de Banca Plano es el empuje horizontal de referencia: pectoral, deltoide anterior y tríceps contra la mayor carga que puedas mover tumbado. Se ejecuta con los pies firmes en el suelo: la barra baja al pecho con los codos bajo la muñeca y sube en línea casi vertical hasta bloquear los brazos. Hay días en que conviene cambiar de escenario: con mancuernas cada brazo se responsabiliza de su lado y los desbalances salen a la luz, perfecto como accesorio del press principal; y la Smith, con su recorrido guiado, es el lugar más seguro para visitar el fallo muscular. El medidor más honesto de la fuerza de empuje y un constructor de pecho que nunca falla." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[516,699][1254,1033]" drawing-order="3" hint="" /><node index="4" text="" resource-id="" class="android.widget.HorizontalScrollView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[90,1119][1254,1182]" drawing-order="4" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="fa