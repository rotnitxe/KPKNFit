enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,441][573,483]" drawing-order="0" hint="" /><node index="1" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[48,513][1296,1018]" drawing-order="1" hint=""><node index="0" text="Aductores" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,555][249,594]" drawing-order="0" hint="" /><node index="1" text="Plancha Copenhague" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,618][1254,675]" drawing-order="1" hint="" /><node index="2" text="La Plancha Copenhague convierte los aductores en el puente del cuerpo: de lado, con la pierna superior apoyada en un banco, la cara interna del muslo sostiene la cadera en el aire. Se ejecuta apoyando el antebrazo y aguantando la línea recta de cabeza a pies el mayor tiempo posible. El core asiste en la estabilidad lateral. La plancha más dura por centímetro cuadrado y la mejor protección de ingle que existe." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,699][1254,976]" drawing-order="2" hint="" /></node><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[48,1048][1296,1553]" drawing-order="2" hint=""><node index="0" text="Aductores" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1090][249,1129]" drawing-order="0" hint="" /><node index="1" text="Plancha Copenhague Dinámica" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1153][1254,1210]" drawing-order="1" hint="" /><node index="2" text="La Plancha Copenhague Dinámica mete movimiento en la postura lateral: con la pierna arriba apoyada, la cadera baja y sube sin tocar el suelo. Los aductores trabajan ahora en acortamiento y estiramiento, no solo en isometría, y la fatiga llega el doble de rápido. Se ejecuta con el antebrazo firme y el ritmo lento. La progresión para quien la versión estática ya respira tranquila." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1234][1254,1511]" drawing-order="2" hint="" /></node></node><node index="2" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusab