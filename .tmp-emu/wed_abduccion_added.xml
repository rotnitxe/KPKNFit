alse" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2357][255,2396]" drawing-order="0" hint="" /><node index="1" text="Aperturas Inclinadas" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2420][1254,2477]" drawing-order="1" hint="" /><node index="2" text="Las Aperturas Inclinadas llevan el abrazo amplio a la parte alta del pecho: en el banco inclinado, el estiramiento bajo carga se concentra en las fibras claviculares del pectoral. Se ejecutan como su hermana plana pero con el torso elevado, dejando que las mancuernas abran el arco hasta sentir el tirón y cerrando con control. La máquina de aperturas sostiene la trayectoria cuando la fatiga empieza a mandar. Detalle fino para un pecho completo visto de frente." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2501][1254,2778]" drawing-order="2" hint="" /><node index="3" text="" resource-id="" class="android.widget.HorizontalScrollView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2802][1254,2865]" drawing-order="3" hint=""><node NAF="true" index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2762][403,2906]