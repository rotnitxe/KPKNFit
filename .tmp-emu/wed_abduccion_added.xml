checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1798][1254,1855]" drawing-order="1" hint="" /><node index="2" text="Las Aperturas Declinadas ponen el torso cabeza abajo para apuntar al borde inferior del pectoral: el arco se abre desde un ángulo que rara vez se entrena aislado. Se ejecutan en banco declinado con las piernas aseguradas, abriendo las mancuernas con los codos suaves y cerrando sobre el pecho bajo. El acabado inferior del pectoral tiene aquí su herramienta específica." resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,1879][1254,2156]" drawing-order="2" hint="" /><node index="3" text="" resource-id="" class="android.widget.HorizontalScrollView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2180][1254,2243]" drawing-order="3" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[90,2140][403,2284]" drawing-order="0" hint=""><node index="0" text="Con Mancuernas" resource-id="" class="android.widget.TextView" package="com.example.kpkn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[117,2192][376,2231]" drawing-order="