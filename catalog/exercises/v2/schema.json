{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KPKN Exercise Catalog v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogRevision",
    "ontologyRevision",
    "families"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "catalogRevision": {
      "type": "string",
      "minLength": 1
    },
    "ontologyRevision": {
      "type": "string",
      "minLength": 1
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/family"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "reviewStatus",
        "confidence",
        "evidenceRefs"
      ],
      "properties": {
        "reviewStatus": {
          "enum": [
            "DRAFT",
            "REVIEWED",
            "APPROVED"
          ]
        },
        "confidence": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": [
        "movementPatternId",
        "bodyRegion",
        "kineticChain",
        "laterality",
        "equipmentId",
        "loadMode",
        "primaryMuscles",
        "secondaryMuscles",
        "stabilizerMuscles",
        "jointInvolvement",
        "description",
        "efc",
        "cnc",
        "ssc",
        "ttc",
        "axialLoadFactor",
        "technicalDifficulty",
        "resistanceProfile",
        "setupCues",
        "executionCues",
        "performanceProfileId"
      ],
      "properties": {
        "movementPatternId": {
          "type": "string",
          "minLength": 1
        },
        "bodyRegion": {
          "enum": [
            "UPPER",
            "LOWER",
            "CORE",
            "FULL"
          ]
        },
        "kineticChain": {
          "enum": [
            "ANTERIOR",
            "POSTERIOR",
            "FULL"
          ]
        },
        "laterality": {
          "enum": [
            "BILATERAL",
            "UNILATERAL",
            "ALTERNATING",
            "NOT_APPLICABLE"
          ]
        },
        "equipmentId": {
          "type": "string",
          "minLength": 1
        },
        "loadMode": {
          "type": "string",
          "minLength": 1
        },
        "primaryMuscles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "secondaryMuscles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stabilizerMuscles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "minLength": 40
        },
        "jointInvolvement": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "jointId",
              "role",
              "actions"
            ],
            "properties": {
              "jointId": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "PRIMARY",
                  "SECONDARY",
                  "STABILIZER"
                ]
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "efc": {
          "type": "number",
          "minimum": 0
        },
        "cnc": {
          "type": "number",
          "minimum": 0
        },
        "ssc": {
          "type": "number",
          "minimum": 0
        },
        "ttc": {
          "type": "number",
          "minimum": 0
        },
        "axialLoadFactor": {
          "type": "number",
          "minimum": 0
        },
        "technicalDifficulty": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "resistanceProfile": {
          "type": "string",
          "minLength": 1
        },
        "setupCues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "executionCues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "performanceProfileId": {
          "type": "string",
          "minLength": 1
        },
        "replacementGroup": {
          "type": [
            "string",
            "null"
          ]
        },
        "replacementPriority": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "automationEligible": {
          "type": "boolean"
        },
        "richMetadata": {
          "$ref": "#/$defs/richMetadata"
        },
        "articulationType": {
          "type": "string",
          "enum": [
            "MULTIARTICULAR",
            "AISLADO"
          ]
        },
        "setupTimeSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "fatigueTier": {
          "type": "string",
          "enum": [
            "BAJA",
            "MEDIA",
            "ALTA"
          ]
        }
      },
      "additionalProperties": false
    },
    "richMetadata": {
      "type": "object",
      "required": [
        "identity",
        "anatomy",
        "biomechanics",
        "programming",
        "fatigue",
        "replacement",
        "display",
        "evidenceConfidence"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "required": [
            "catalogRevision",
            "familyId",
            "definitionId",
            "configurationId",
            "canonicalName",
            "searchTerms",
            "kind",
            "performanceProfileId"
          ]
        },
        "anatomy": {
          "type": "object",
          "required": [
            "primaryMuscles",
            "secondaryMuscles",
            "stabilizerMuscles",
            "jointActions",
            "volumeContribution"
          ]
        },
        "biomechanics": {
          "type": "object",
          "required": [
            "movementPatternId",
            "bodyRegion",
            "kineticChain",
            "laterality",
            "equipmentId",
            "loadMode",
            "resistanceProfile",
            "stability",
            "relevantJoints"
          ]
        },
        "programming": {
          "type": "object",
          "required": [
            "role",
            "indicativeRestSeconds",
            "fatigueCost",
            "requiredEquipment"
          ]
        },
        "fatigue": {
          "type": "object",
          "required": [
            "efc",
            "cnc",
            "ssc",
            "ttc",
            "axialLoadFactor",
            "technicalDifficulty"
          ]
        },
        "replacement": {
          "type": "object",
          "required": [
            "replacementGroup",
            "replacementPriority",
            "compatibleEquipmentIds",
            "preservesIntent"
          ]
        },
        "display": {
          "type": "object",
          "required": [
            "displayName",
            "displaySummary",
            "selectedOptions"
          ]
        },
        "evidenceConfidence": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        }
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "required": [
        "id",
        "selectedOptions",
        "displaySummary",
        "profile",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "selectedOptions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "displaySummary": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
      "required": [
        "id",
        "familyId",
        "kind",
        "canonicalName",
        "description",
        "searchTerms",
        "optionAxes",
        "configurations",
        "defaultConfigurationId",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "familyId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "PARENT",
            "SPECIALTY"
          ]
        },
        "canonicalName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 40
        },
        "searchTerms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "optionAxes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "configurations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/configuration"
          }
        },
        "defaultConfigurationId": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "additionalProperties": false
    },
    "family": {
      "type": "object",
      "required": [
        "id",
        "canonicalName",
        "definitions",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "canonicalName": {
          "type": "string",
          "minLength": 1
        },
        "definitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/definition"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "taxonomy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$comment": "Fields retired in F1 (benefits, techniqueSummary, variantRationale, commonMistakes, muscleNotes, evidence.rationale, family.description, joint notes, richMetadata editorial/coaching/safety and the listed anatomy/biomechanics/programming members) are rejected by additionalProperties and by scripts/catalog_v2_retired_fields.py. Derived fields (jointActions, relevantJoints, preservesIntent) are produced by scripts/catalog_v2_derived.py."
}
